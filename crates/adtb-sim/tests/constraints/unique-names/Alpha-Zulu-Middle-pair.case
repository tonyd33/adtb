@entry
engine
@decls
module app
add module app
add type Row { id: I64, slug: Text } = Alpha | Zulu | Middle
add relation rows : Row key id unique (slug) in (Zulu | Alpha)
@seed
insert rows.Zulu { id: 1, slug: "same" }
@write
insert rows.Alpha { id: 2, slug: "same" }
@constraint
app::rows.unique(slug) in (Alpha | Zulu)
@before
Zulu { id: 1, slug: "same" }
@report
Zulu { id: 1, slug: "same" }~Alpha { id: 2, slug: "same" }
Alpha { id: 2, slug: "same" }~Zulu { id: 1, slug: "same" }
@catalog

