@entry
engine
@decls
module app
add module app
add type Row { id: I64, slug: Text } = Zulu | Alpha | Middle
add relation rows : Row key id unique (slug) in (Middle | Alpha | Zulu)
@seed
insert rows.Zulu { id: 1, slug: "same" }
@write
insert rows.Alpha { id: 2, slug: "same" }
@constraint
app::rows.unique(slug)
@before
Zulu { id: 1, slug: "same" }
@report
Zulu { id: 1, slug: "same" }~Alpha { id: 2, slug: "same" }
Alpha { id: 2, slug: "same" }~Zulu { id: 1, slug: "same" }
@catalog

