@entry
reference
@decls
type Row { id: I64, slug: Text } = Zulu | Alpha | Middle
relation rows : Row key id unique (slug) in Selected
set Selected of rows = Middle | Zulu | Alpha
@seed
insert rows.Zulu { id: 1, slug: "same" }
@write
insert rows.Alpha { id: 2, slug: "same" }
@constraint
app::rows.unique(slug)
@before
Zulu { id: 1, slug: "same" }
@report
Zulu { id: 1, slug: "same" }~Alpha { id: 2, slug: "same" }
Alpha { id: 2, slug: "same" }~Zulu { id: 1, slug: "same" }
@catalog

