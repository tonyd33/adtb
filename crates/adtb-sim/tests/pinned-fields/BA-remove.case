module auth
add module auth
add type Thing { id: Key things } = B { x: Text } | A { x: Text } | C
add relation things : Thing key id generate sequence
add set Selected of things = A | B

===
module auth
deprecate things.A

+++
module auth
remove constructor Thing.A

===
import auth
query values () -> Set Text = from v in things.Selected select v.x

