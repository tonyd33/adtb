# A deleted read of one constructor under `not` is refused naming the constructor relation.
migrate refused MigrationRefused { version: 1, reason: Rejected { reason: SchemaRefused { operator: "", detail: "constraint app::stays_closed is not admitted: `deleted(app::accounts.Closed)` is read under negation" } } }
  module app
  add module app
  add type User = { id: Key users, name: Text }
  add relation users : User key id generate sequence
  add type Account { id: Key accounts, owner: Key users, opened: Instant }
    = Open
    | Closed { closed: Instant }
  add relation accounts : Account key id generate sequence
  add type Event = { id: Key events, at: Instant, body: Text }
  add relation events : Event key id generate sequence
  add constraint stays_closed =
    from a in accounts.Open
    where not (exists d in deleted(accounts.Closed) where key d == key a)
    select a
