# An inclusion without an index on its source is refused naming the index, and admitted once the
# index is declared.
migrate refused MigrationRefused { version: 1, reason: Rejected { reason: SchemaRefused { operator: "", detail: "constraint app::assigned_member is not admitted: changes to app::memberships: index (user, org) in app::assignments is missing" } } }
  module app
  add module app
  add type Membership = { id: Key memberships, user: Text, org: Text }
  add relation memberships : Membership
    key id generate sequence
    unique (user, org)
  add type Assignment = { id: Key assignments, user: Text, org: Text, task: Text }
  add relation assignments : Assignment key id generate sequence
  add constraint assigned_member =
    from a in assignments
    where not exists m in memberships where m.user == a.user and m.org == a.org
