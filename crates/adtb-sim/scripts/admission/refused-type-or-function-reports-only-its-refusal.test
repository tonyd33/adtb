# A refused `add type` or `define fn` reports its own refusal: a declaration naming the refused
# type or function reports nothing more.

migrate refused MigrationRefused { version: 1, reason: Rejected { reason: SchemaRefused { operator: "add type Item = { id: Key items, n: Zz }", detail: "no type `Zz`" } } }
  module app
  add module app
  add type Item = { id: Key items, n: Zz }
  add relation items : Item key id generate sequence
  add type Label = { id: Key labels, item: Item, ref: Key items }
  add relation labels : Label key id generate sequence
  define fn first () -> Set Item = from x in items select x
  define fn make () -> Item = Item { id: 1, n: 2 }

migrate refused MigrationRefused { version: 1, reason: Rejected { reason: SchemaRefused { operator: "define fn bad () -> I64 = 1 + \"a\"", detail: "`+` does not apply to I64 and Text" } } }
  module app
  add module app
  define fn bad () -> I64 = 1 + "a"
  define fn c () -> I64 = bad()
  define fn d () -> I64 = c() + bad()
  add type Note = { id: Key notes, n: I64 }
  add relation notes : Note key id generate sequence
  add constraint big = from x in notes where x.n > bad() select x
