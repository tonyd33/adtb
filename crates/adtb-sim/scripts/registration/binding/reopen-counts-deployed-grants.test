seed 354
use binding-files

grant
  grant read catalog::constructors to ann with grant option
  grant read_files to ann

as ann register cat-1.0 pins 3 edition "2026-10" lease 8d use ctors
as ann register load-1.0 pins 3 edition "2026-10" lease 8d use scan
bundle cat-1.0 pins 3 edition "2026-10" lease 8d use ctors
bundle load-1.0 pins 3 edition "2026-10" lease 8d use scan
reopen

run
  retire bundle load-1.0

bundle cat-1.0 pins 3 edition "2026-10" lease 8d use ctors
migrate
  module shop
  add type Note = { id: Key notes, text: Text }
  add relation notes : Note key id generate sequence
