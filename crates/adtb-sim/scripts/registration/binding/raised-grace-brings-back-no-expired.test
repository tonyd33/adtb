seed 370
use binding

grant
  grant read catalog::constructors to ann with grant option

as ann register cat-1.0 pins 2 edition "2026-10" lease 8d use ctors

as ann grant
  grant call cat-1.0 to web

as web call cat-1.0
advance 9d

revoke
  revoke read catalog::constructors from ann

run
  set setting LeaseGrace = { grace: 30d }

as web call cat-1.0 error BundleExpired { bundle: "cat-1.0", query: "" }

as web call cat-1.0 1 error BundleExpired { bundle: "cat-1.0", query: "ctors" }

reopen

as web call cat-1.0 error BundleExpired { bundle: "cat-1.0", query: "" }

as ann register cat-1.0 pins 2 edition "2026-10" lease 8d use ctors error Denied { detail: "ctors reads constructors.Constructor; ann lacks read with grant option\nctors reads constructors.Constructor (id); ann lacks read with grant option\nctors reads constructors.Constructor (name); ann lacks read with grant option" }

as web call cat-1.0 error BundleExpired { bundle: "cat-1.0", query: "" }

grant
  grant read catalog::constructors to ann with grant option

as ann register cat-1.0 pins 2 edition "2026-10" lease 8d use ctors

as web call cat-1.0 1
----
"Customer"

reopen

as web call cat-1.0
