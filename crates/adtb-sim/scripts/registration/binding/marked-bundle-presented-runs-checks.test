reopen refused RegistrationRefused { bundle: "cat-1.0", reason: Rejected { reason: Denied { detail: "ctors reads constructors.Constructor; ann lacks read with grant option\nctors reads constructors.Constructor (id); ann lacks read with grant option\nctors reads constructors.Constructor (name); ann lacks read with grant option" } } }
