seed 345
use binding

grant
  grant read catalog::constructors to ann with grant option

as ann register cat-1.0 pins 2 edition "2026-10" lease 8d use ctors
as ann register dog-1.0 pins 2 edition "2026-10" lease 8d use ctors

revoke error Invalid { detail: "`revoke read catalog::constructors from ann` leaves live bundles lacking what they use:\nbundle cat-1.0: ctors reads constructors.Constructor; ann lacks read with grant option\nbundle cat-1.0: ctors reads constructors.Constructor (id); ann lacks read with grant option\nbundle cat-1.0: ctors reads constructors.Constructor (name); ann lacks read with grant option\nbundle dog-1.0: ctors reads constructors.Constructor; ann lacks read with grant option\nbundle dog-1.0: ctors reads constructors.Constructor (id); ann lacks read with grant option\nbundle dog-1.0: ctors reads constructors.Constructor (name); ann lacks read with grant option" }
  revoke read catalog::constructors from ann

run
  retire bundle cat-1.0

revoke error Invalid { detail: "`revoke read catalog::constructors from ann` leaves live bundles lacking what they use:\nbundle dog-1.0: ctors reads constructors.Constructor; ann lacks read with grant option\nbundle dog-1.0: ctors reads constructors.Constructor (id); ann lacks read with grant option\nbundle dog-1.0: ctors reads constructors.Constructor (name); ann lacks read with grant option" }
  revoke read catalog::constructors from ann

run
  retire bundle dog-1.0

revoke
  revoke read catalog::constructors from ann

query
  from g in catalog::grants where g.grantee == "ann" select { privilege: g.privilege, target: g.target, option: g.grant_option }
