# Each index element is stored as its canonical source text.
migrate
  module app
  add module app
  add type Status = Draft | Sent { at: I64 }
  add type Label = { id: Key tags, item: Key items, n: I64 }
  add type Item = { id: Key items, name: Text, n: I64, f: F64, d: Decimal 2, s: Status,
    when: Instant }
  define fn twice (x: I64) -> I64 = x * 2
  define fn apply (g: I64 -> Bool, x: I64) -> Bool = g(x)
  add relation tags : Label key id generate sequence
  add relation items : Item key id generate sequence
    index (n + 007)
    index (d + 01.50)
    index (f + 1.50e03)
    index (name ++ "a\"b\\c\td")
    index (when + 090s)
    index (n > 0 or true)
    index (match s | Draft -> 0 | Sent t -> t.at)
    index (app::twice(n))
    index (apply(fn y -> y > 0, n))
    index (Instant.parse(name))
    index (Sent { at: n })
    index (Draft)
    index ({ a: name, b: n })
    index (if () == () then n else 0)
    index (-n)
    index ({ a: n }.a)
    index (items.key(n))
    index (if n > 0 then name else "none")

query rowsort
  from i in catalog::indexes, r in catalog::relations where i.relation == key r and r.name == "items" and i.clause != "key id" select i.clause
