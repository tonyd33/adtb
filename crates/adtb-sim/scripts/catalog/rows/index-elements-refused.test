# An index element that is no scalar expression of the row is refused, with its canonical text.

migrate refused MigrationRefused { version: 1, reason: Rejected { reason: SchemaRefused { operator: "", detail: "index `index (count ( x for x in app::items where x . n == 1 ))` is not admitted: an aggregate in a scalar expression" } } }
  module app
  add module app
  add type Status = Draft | Sent { at: I64 }
  add type Label = { id: Key tags, item: Key items, n: I64 }
  add type Item = { id: Key items, name: Text, n: I64, f: F64, d: Decimal 2, s: Status,
    when: Instant }
  define fn twice (x: I64) -> I64 = x * 2
  define fn apply (g: I64 -> Bool, x: I64) -> Bool = g(x)
  add relation tags : Label key id generate sequence
  add relation items : Item key id generate sequence
    index (count(x for x in items where x.n == 1))

