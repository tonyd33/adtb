# A function over a Wasm module refuses its migration, since the engine does not run Wasm
# functions, and the log keeps no row of it.
use empty

migrate refused MigrationRefused { version: 1, reason: Rejected { reason: SchemaRefused { operator: "add module app", detail: "function `f` names Wasm module `m`: the engine does not run Wasm functions yet" } } }
  module app
  add module app
  define fn f (x: I64) -> I64 = wasm "m" export "f"

reopen

query
  count(m for m in catalog::migrations)
----
0
