sys::field_values key (relation, ctor, field, value) over FieldValue
sys::format.Format heap
sys::format key id over Format
sys::horizons.Horizon heap
sys::horizons key (relation, ctor) over Horizon
sys::jobs.Job heap
sys::jobs key id over Job
sys::pending_drops.PendingDrop heap
sys::pending_drops key (object, blocking) over PendingDrop
sys::process_options.ProcessOption heap
sys::process_options key id over ProcessOption
sys::process_options unique (name) over ProcessOption
sys::query_ctor_stats.QueryCtorStats heap
sys::query_ctor_stats key (query, fingerprint, plan, relation, ctor) over QueryCtorStats
sys::query_stats.QueryStats heap
sys::query_stats key (query, fingerprint, plan) over QueryStats
sys::query_windows.QueryWindow heap
sys::query_windows key (query, fingerprint, plan, start) over QueryWindow
sys::request_marks.RequestMark heap
sys::request_marks key id over RequestMark
sys::request_marks unique (client) over RequestMark
sys::safe_snapshots.SafeSnapshotMark heap
sys::safe_snapshots key position over SafeSnapshotMark
sys::sessions.Session heap
sys::sessions key id over Session
sys::vacuums.Vacuum heap
sys::vacuums key id over Vacuum
sys::vacuums unique (relation, ctor) over Vacuum
sys::verify_findings.Checksum heap
sys::verify_findings.StalePage heap
sys::verify_findings.Order heap
sys::verify_findings.Orphan heap
sys::verify_findings.Missing heap
sys::verify_findings.Violation heap
sys::verify_findings.Structure heap
sys::verify_findings key id over Checksum | StalePage | Order | Orphan | Missing | Violation | Structure
sys::wait_samples.WaitSample heap
sys::wait_samples key (at, call) over WaitSample
sys::wait_totals.WaitTotal heap
sys::wait_totals key (reason, query, fingerprint) over WaitTotal
sys::CallState order Queued < Running < Waiting
sys::Finding order Checksum < StalePage < Order < Orphan < Missing < Violation < Structure
sys::JobKind order Reindex < Compact < SchemaStage < Verify
sys::SessionState order Idle < Busy < InTransaction
sys::WaitReason order StorageRead < FileRead < LogFlush < Internal < SafeSnapshot < Inserter < Admission
