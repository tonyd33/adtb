# A merge of a dormant row holding a grant option into an active one keeps the active row
# without the option.
use shop
use grants-dumper

role ghost

migrate
  module shop
  grant read customers to ghost with grant option

as dumper run
  dump to "out/d"

restore out/d to copy.adt
----
dormant { id: 1, grantee: "dumper", privilege: "read", target: "shop::customers frozen (id, name)" }
dormant { id: 2, grantee: "dumper", privilege: "read", target: "shop::payments frozen (id, customer, Card.last4, Invoice.due)" }
dormant { id: 129, grantee: "ghost", privilege: "read", target: "shop::customers frozen (id, name)" }

reopen

role ghost

migrate
  module shop
  add field Customer.email: Text fill ""

migrate
  module shop
  grant read customers to ghost

query rowsort
  from g in catalog::grants where g.grantee == "ghost" select { privilege: g.privilege, target: g.target, grant_option: g.grant_option, dormant: g.dormant, was_active: exists c in customers where c.name == "was_active " ++ print(value(key g)) }
----
{ dormant: False, grant_option: False, privilege: "read", target: Some { value: "shop::customers frozen (id, name, email)" }, was_active: False }
{ dormant: True, grant_option: True, privilege: "read", target: Some { value: "shop::customers frozen (id, name)" }, was_active: False }

# The id of each active grant of ghost, as a customer's name.
run
  insert customers from (from g in catalog::grants where g.grantee == "ghost" and not g.dormant select { name: "was_active " ++ print(value(key g)), email: "" })

migrate
  module shop
  drop field Customer.email

query rowsort
  from g in catalog::grants where g.grantee == "ghost" select { privilege: g.privilege, target: g.target, grant_option: g.grant_option, dormant: g.dormant, was_active: exists c in customers where c.name == "was_active " ++ print(value(key g)) }
----
{ dormant: False, grant_option: False, privilege: "read", target: Some { value: "shop::customers frozen (id, name)" }, was_active: True }

