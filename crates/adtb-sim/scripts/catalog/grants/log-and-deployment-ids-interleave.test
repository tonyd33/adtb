migrate refused MigrationRefused { version: 8, reason: Rejected { reason: SchemaRefused { operator: "add constraint paid =", detail: "constraint shop::paid is violated by Customer { id: clients.key(1), name: \"ann\" }" } } }
  module shop
  grant delete clients to web
  add constraint paid =
    from c in clients
    where c.name == "ann" and not exists p in payments where p.customer == key c
    select c

reopen

