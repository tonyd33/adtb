  from g in catalog::grants select { kind: g.kind, privilege: g.privilege, grantee: g.grantee, target: g.target, grant_option: g.grant_option, seen: exists c in clients where c.name == "id " ++ print(value(key g)), same: exists c in clients where c.name == "grant " ++ print(value(key g)) ++ " " ++ g.privilege ++ " " ++ g.grantee }
