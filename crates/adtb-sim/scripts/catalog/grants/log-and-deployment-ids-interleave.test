migrate
  module shop
  rename relation customers to clients
  rename field Payment.Card.last4 to digits

migrate
  module shop
  grant read clients to web with grant option

migrate
  module shop
  split constructor Payment.Card into Visa { digits: Text } | Other { digits: Text }
    by match
      | Card { digits } -> Visa { digits: digits }

