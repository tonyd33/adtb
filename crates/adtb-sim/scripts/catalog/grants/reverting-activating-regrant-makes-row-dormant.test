# Reverting a grant over an active row leaves it active; reverting the regrant that activated a
# dormant row makes it dormant again.
use shop
use grants-dumper

role ghost

migrate
  module shop
  grant read customers to ghost

as dumper run
  dump to "out/d"

restore out/d to copy.adt
----
dormant { id: 1, grantee: "dumper", privilege: "read", target: "shop::customers frozen (id, name)" }
dormant { id: 2, grantee: "dumper", privilege: "read", target: "shop::payments frozen (id, customer, Card.last4, Invoice.due)" }
dormant { id: 129, grantee: "ghost", privilege: "read", target: "shop::customers frozen (id, name)" }

reopen

# The id of each grant of ghost the restore left, as a customer's name.
run
  insert customers from (from g in catalog::grants where g.grantee == "ghost" select { name: "was_dormant " ++ print(value(key g)) })

role ghost

migrate
  module shop
  grant read customers to ghost

query rowsort
  from g in catalog::grants where g.grantee == "ghost" select { privilege: g.privilege, target: g.target, grant_option: g.grant_option, dormant: g.dormant, was_dormant: exists c in customers where c.name == "was_dormant " ++ print(value(key g)) }
----
{ dormant: False, grant_option: False, privilege: "read", target: Some { value: "shop::customers frozen (id, name)" }, was_dormant: True }

migrate
  module shop
  grant read customers to ghost with grant option

reopen

migrate
  module shop
  revert 0005

query rowsort
  from g in catalog::grants where g.grantee == "ghost" select { privilege: g.privilege, target: g.target, grant_option: g.grant_option, dormant: g.dormant, was_dormant: exists c in customers where c.name == "was_dormant " ++ print(value(key g)) }
----
{ dormant: False, grant_option: False, privilege: "read", target: Some { value: "shop::customers frozen (id, name)" }, was_dormant: True }

migrate
  module shop
  revert 0004

query rowsort
  from g in catalog::grants where g.grantee == "ghost" select { privilege: g.privilege, target: g.target, grant_option: g.grant_option, dormant: g.dormant, was_dormant: exists c in customers where c.name == "was_dormant " ++ print(value(key g)) }
----
{ dormant: True, grant_option: False, privilege: "read", target: Some { value: "shop::customers frozen (id, name)" }, was_dormant: True }

