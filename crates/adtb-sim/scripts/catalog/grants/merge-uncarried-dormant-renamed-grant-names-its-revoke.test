# The revoke a merge names for an uncarried dormant grant uses the names an earlier rename of
# the same migration gave, and applies after it.
use shop
use grants-dumper

role ghost

migrate
  module shop
  grant read payments.Card (Card.last4) to ghost

as dumper run
  dump to "out/d"

restore out/d to copy.adt
----
dormant { id: 1, grantee: "dumper", privilege: "read", target: "shop::customers frozen (id, name)" }
dormant { id: 2, grantee: "dumper", privilege: "read", target: "shop::payments frozen (id, customer, Card.last4, Invoice.due)" }
dormant { id: 129, grantee: "ghost", privilege: "read", target: "shop::payments.Card (Card.last4)" }

migrate refused MigrationRefused { version: 4, reason: Rejected { reason: SchemaRefused { operator: "merge constructor Payment.(Cardx | Invoice) into Paid { via: Via, note: Text }", detail: "the merge of `Cardx`, `Invoice` into `Paid` cannot carry the `read` grant of `ghost` on `payments`, which does not cover each of them alike; the grant is dormant: `revoke read payments.Cardx (Cardx.last4) from ghost` before this operator in the same migration, or grant `read` on `payments.Paid` to `ghost` there once role `ghost` exists" } } }
  module shop
  rename constructor Payment.Card to Cardx
  add type Via = Cardx | Invoice
  merge constructor Payment.(Cardx | Invoice) into Paid { via: Via, note: Text }
    by match
      | Cardx c -> Paid { via: Cardx, note: c.last4 }
      | Invoice i -> Paid { via: Invoice, note: i.due }

migrate
  module shop
  rename constructor Payment.Card to Cardx
  revoke read payments.Cardx (Cardx.last4) from ghost
  add type Via = Cardx | Invoice
  merge constructor Payment.(Cardx | Invoice) into Paid { via: Via, note: Text }
    by match
      | Cardx c -> Paid { via: Cardx, note: c.last4 }
      | Invoice i -> Paid { via: Invoice, note: i.due }

query rowsort
  from g in catalog::grants where g.grantee == "ghost" select g.privilege
----
