seed 17
use history

# Migrations past the database's version 1, which no open applies.
log
  module stock
  rename field Item.Open.qty to count
  module stock
  rename field Item.Open.count to qty

error Invalid { detail: "an `at` block pins version 3, which the log does not hold: it is at version 1" }
  at commit $first pins 3 { from i in items select i.name }
