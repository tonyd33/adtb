seed 1

migrate
  module shop
  add module shop
  add type Customer = { id: Key customers, name: Text }
  add relation customers : Customer key id generate sequence
  add type Payment { id: Key payments, customer: Key customers }
    = Card { last4: Text }
    | Invoice { due: Text, payer: Key customers }
  add relation payments : Payment
    key id generate sequence
    index (customer)
  add set Billed of payments = Invoice
  add constraint nameless = from c in customers where c.name == "" select c
  define fn shout (c: Customer) -> Text = c.name ++ "!"
  add computed customers.loud: Text = self.name ++ "!"

migrate
  module shop
  rename field Customer.name to full_name
  rename constructor Payment.Card to Debit
  rename relation customers to clients

reopen

