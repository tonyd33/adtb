# A role's call reads the audit for its row's number under its own grant: the first call after an
# open, under a grant smaller than the audit's rows, fails for its grant, though its query alone
# fits.
use adhoc

option query_memory_bytes 8192
reopen

query
  count(d for d in docs.Draft)
----
1

as reader failed StatementLimit { limit: Memory { bytes: 8192 } }
  count(d for d in docs.Draft)
