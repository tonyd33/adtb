as ops error Denied { detail: "role `ops` lacks `configure`" }
  set setting RetryLimit = { retries: 1 }

query
  count(a for a in catalog::audit.Denied where a.role == "ops")
----
7

as ops error Denied { detail: "role `ops` lacks `configure`" }
  set setting Nope = 1

