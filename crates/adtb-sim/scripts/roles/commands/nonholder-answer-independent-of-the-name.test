seed 171
use secrets
role ops

grant
  grant adhoc to ops
  grant monitor to ops

as ops error Denied { detail: "role `ops` lacks `maintain`" }
  vacuum secrets

query
  count(a for a in catalog::audit.Denied where a.role == "ops")
----
1

as ops error Denied { detail: "role `ops` lacks `maintain`" }
  vacuum nosuch

query
  count(a for a in catalog::audit.Denied where a.role == "ops")
----
2

as ops error Denied { detail: "role `ops` lacks `maintain`" }
  verify secrets

query
  count(a for a in catalog::audit.Denied where a.role == "ops")
----
3

as ops error Denied { detail: "role `ops` lacks `maintain`" }
  verify nosuch

query
  count(a for a in catalog::audit.Denied where a.role == "ops")
