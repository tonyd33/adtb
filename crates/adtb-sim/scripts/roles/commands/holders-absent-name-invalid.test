seed 170
use secrets
role dba

grant
  grant adhoc to dba
  grant maintain to dba

as dba error Invalid { detail: "no `nosuch` in scope" }
  vacuum nosuch

query
  count(a for a in catalog::audit.Denied where a.role == "dba")
----
0

query
  count(a for a in catalog::audit.Call where a.role == "dba")
----
1
