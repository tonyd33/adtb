seed 148
use secrets

grant
  grant adhoc to w
  grant assert to w
  grant schema to w
  grant monitor to w
  grant cancel to w
  grant maintain to w
  grant configure to w
  grant read_files to w
  grant write_files to w

as w error Denied { detail: "this command as written runs only for the embedded owner's role" }
  set setting RetryLimit = { retries: count(i for i in secrets) }

query
  count(a for a in catalog::audit.Denied where a.role == "w")
----
1

as w error Denied { detail: "this command as written runs only for the embedded owner's role" }
  set setting RetryLimit = { retries: from i in secrets select i.nope }

query
  count(a for a in catalog::audit.Denied where a.role == "w")
----
2

as w error Denied { detail: "this command as written runs only for the embedded owner's role" }
  set setting RetryLimit = { retries: nosuch }

query
  count(a for a in catalog::audit.Denied where a.role == "w")
