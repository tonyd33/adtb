seed 665
use adhoc
grant
  grant maintain to bare
as bare run
  vacuum secrets
as bare run
  verify secrets
as bare run
  reindex secrets
as bare error Invalid { detail: "no `nosuch` in scope" }
  verify nosuch
as bare error Denied { detail: "role `bare` may not run this text" }
  vacuum secrets
  from s in secrets select s.salary
as bare error Denied { detail: "role `bare` may not run this text" }
  vacuum nosuch
  from s in nosuch select s
