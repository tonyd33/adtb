# A revert that enables a disabled constructor is refused while a live bundle pinned before the
# constructor reads its relation whole.
seed 111
use states
log
  module auth
  add constructor Identity.Apple { sub: Text }
    joins identities.OAuth
  module auth
  enable identities.Apple
  module auth
  disable identities.Apple
  rename constructor Identity.Apple to Pear
bundle web-1.0 pins 1 edition "2026-10"
  import auth
  query count () -> I64 = count(key i for i in identities)
reopen

bundle web-1.0 pins 1 edition "2026-10"
  import auth
  query count () -> I64 = count(key i for i in identities)
migrate refused MigrationRefused { version: 5, reason: Rejected { reason: SchemaRefused { operator: "revert 0004", detail: "`enable identities.Apple` is refused: bundle web-1.0, pinned at version 1, reads identities whole; a bundle stops blocking only when it is released" } } }
  module auth
  revert 0004
