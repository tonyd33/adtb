# An enable refused for a live bundle applies when presented again once the bundle is released.
seed 80
use states
log
  module auth
  add constructor Identity.Apple { sub: Text }
    joins identities.OAuth
bundle web-1.0 pins 1 edition "2026-10"
  import auth
  query count () -> I64 = count(key i for i in identities)
reopen

bundle web-1.0 pins 1 edition "2026-10"
  import auth
  query count () -> I64 = count(key i for i in identities)
migrate refused MigrationRefused { version: 3, reason: Rejected { reason: SchemaRefused { operator: "enable identities.Apple", detail: "`enable identities.Apple` is refused: bundle web-1.0, pinned at version 1, reads identities whole; a bundle stops blocking only when it is released" } } }
  module auth
  enable identities.Apple

bundle web-1.0 pins 1 edition "2026-10"
  import auth
  query count () -> I64 = count(key i for i in identities)
reopen

query
  count(m for m in catalog::migrations)
----
2

reopen

migrate
  module auth
  enable identities.Apple

query
  count(m for m in catalog::migrations)
----
3
