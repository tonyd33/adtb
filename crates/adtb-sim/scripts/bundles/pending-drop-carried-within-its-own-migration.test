# A pending-dropped constraint is carried by the operators after its drop in the same migration.
seed 115
use states
log
  module auth
  add constraint no_blank = from u in users where u.name == "" select u
bundle web-2.0 pins 2 edition "2026-10"
  import auth
  query count () -> I64 = count(key u for u in users)
reopen

bundle web-2.0 pins 2 edition "2026-10"
  import auth
  query count () -> I64 = count(key u for u in users)
migrate
  module auth
  drop constraint no_blank
  rename field User.name to full_name

error Violated { constraint: "auth::no_blank", report: 1 rows, redacted: 0 }
  insert users { full_name: "" }

bundle web-2.0 pins 2 edition "2026-10"
  import auth
  query count () -> I64 = count(key u for u in users)
migrate refused MigrationRefused { version: 4, reason: Rejected { reason: SchemaRefused { operator: "", detail: "pending-dropped auth::no_blank has no image: User has no field `full_name`" } } }
  module auth
  drop field User.full_name
