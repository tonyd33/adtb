seed 89
use auth
use notes
log
  module auth
  add constructor Note.Link { url: Text, body: Text }
  module auth
  enable notes.Link
bundle web-1.0 pins 2 edition "2026-10" hide new constructors use upserts
reopen

run
  insert notes.Link { id: notes.key(1), url: "u", body: "b" }

call web-1.0 1 error KeyViolation { relation: "auth::notes", key: "notes.key(1)" }

query
  from n in notes select match n
    | Plain p -> p.body
    | Link l -> l.url
----
"u"
