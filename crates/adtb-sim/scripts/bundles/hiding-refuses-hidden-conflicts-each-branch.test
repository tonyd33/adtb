seed 195
use auth
use notes-link
bundle web-1.0 pins 2 edition "2026-10" hide new constructors
  import auth
  txn put0 () -> I64 =
    transact
      insert notes.Plain { id: notes.key(1), body: "x" }
        unless conflict on key else skip
      return 0
  txn put1 () -> I64 =
    transact
      insert notes.Plain { id: notes.key(1), body: "x" }
        unless conflict on key else delete old
      return 0
  txn put2 () -> I64 =
    transact
      insert notes.Plain { id: notes.key(1), body: "x" }
        unless conflict on key else update old set Plain { old with body: old.body ++ "!" }
      return 0
  txn put3 () -> I64 =
    transact
      insert notes.Plain { id: notes.key(1), body: "x" }
        unless conflict on key else fail "the conflict branch ran"
      return 0
  txn put4 () -> I64 =
    transact
      insert notes.Plain { id: notes.key(1), body: "x" }
        unless conflict on key else match old | Plain p -> update p set Plain { p with body: "matched" }
      return 0
  txn put5 () -> Note =
    transact
      let written = insert notes.Plain { id: notes.key(1), body: "x" }
        unless conflict on key else skip
      return written
reopen

run
  insert notes.Link { id: notes.key(1), url: "u" }

call web-1.0 1 error KeyViolation { relation: "auth::notes", key: "notes.key(1)" }

query
  from n in notes select n
----
