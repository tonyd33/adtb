# A pending-dropped unique is carried by later operators, stays in force under the field's new
# name, and refuses an operator that leaves it no image.
seed 127
use states
log
  module auth
  add unique (name) in users
bundle web-2.0 pins 2 edition "2026-10"
  import auth
  query count () -> I64 = count(key s for s in sessions)
reopen

run
  insert users { name: "ann" }

bundle web-2.0 pins 2 edition "2026-10"
  import auth
  query count () -> I64 = count(key s for s in sessions)
migrate
  module auth
  drop unique (name) in users

bundle web-2.0 pins 2 edition "2026-10"
  import auth
  query count () -> I64 = count(key s for s in sessions)
migrate
  module auth
  rename field User.name to full_name

error Violated { constraint: "auth::users.unique(full_name)", report: 2 rows, redacted: 0 }
  insert users { full_name: "ann" }

bundle web-2.0 pins 2 edition "2026-10"
  import auth
  query count () -> I64 = count(key s for s in sessions)
migrate refused MigrationRefused { version: 5, reason: Rejected { reason: SchemaRefused { operator: "drop field User.full_name", detail: "pending-dropped auth::users unique (name) has no image: no `full_name` in scope" } } }
  module auth
  drop field User.full_name
