seed 18
use auth
bundle web-1.0 pins 1 edition "2026-10" use names
reopen

bundle web-1.1 pins 1 edition "2026-10" use names
migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "", detail: "module `auth` declares no relation `nothing`" } } }
  module auth
  drop relation nothing

reopen

query rowsort
  from b in catalog::bundles select b.name ++ " " ++ (match b.state | Active -> "active" | Superseded _ -> "superseded" | Retired _ -> "retired")
----
"web-1.0 superseded"
"web-1.1 superseded"

query
  count(r for r in catalog::registered where r.bundle.name == "web-1.1")
----
0
