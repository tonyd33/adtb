seed 1153
use auth
use auth-apple
reopen
role app
migrate
  module auth
  grant read users to app with grant option
  grant read sessions to app with grant option
  grant read identities.EmailPass to app with grant option
  grant read identities.Google to app with grant option
run
  insert users { id: users.key(1), name: "ann", tier: Free }
  insert identities.Google { id: identities.key(1), user: users.key(1), gid: "g-ann" }
  insert sessions { id: sessions.key(1), who: identities.key(1) }

as app register web-1.0 pins 1 edition "2026-10" hide new constructors use hiding

call web-1.0 2
