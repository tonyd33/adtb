seed 202
use empty
role ann
role bob
as ann grant error Denied { detail: "role `ann` lacks `monitor`" }
  grant monitor to bob
grant
  grant monitor to ann
as ann grant error Denied { detail: "role `ann` lacks `monitor`" }
  grant monitor to bob
grant
  grant monitor to ann with grant option
as ann grant
  grant monitor to bob

query
  from g in catalog::grants where g.privilege == "monitor" select g.grantee ++ " " ++ g.grantor ++ " " ++ print(g.grant_option)
----
"ann owner True"
"bob ann False"
