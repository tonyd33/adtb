# Queries past their memory grant spill and give the rows the reference gives: each runs with no
# spill bound, and is refused for its grant with no spill space.
use stocked
option query_memory_bytes 32768
option morsel_rows 16
reopen

query rowsort
  from s in stock, n in notes where n.item == key s select { s: s.id, n: n.id }
