# A read through index (k) locks the versions it fetched. A writer deleting another version on
# their page, whose read the reader then writes, commits beside it; one deleting a version read
# fails. A delete adds no index entry, so neither meets the reader's range lock.
use locks
reopen

begin p

in p query
  from i in items where i.k == 0 select key i
----
items.key(1)
items.key(2)
items.key(3)

probe locks p
----
range app::items index (k) over Item
tuple app::items.Item
tuple app::items.Item
tuple app::items.Item

rollback p

begin r1 id R1

begin w1 id W1

in r1 query
  from i in items where i.k == 0 select key i
----
items.key(1)
items.key(2)
items.key(3)

in w1 query
  count(1 for m in marks where m.n == 0)
----
0

in r1 run
  insert marks { n: 1 }

in w1 run
  delete i in items where key i == items.key(4)

commit r1

commit w1

begin r2 id R2

begin w2 id W2

in r2 query
  from i in items where i.k == 0 select key i
----
items.key(1)
items.key(2)
items.key(3)

in w2 query
  count(1 for m in marks where m.n == 0)
----
0

in r2 run
  insert marks { n: 1 }

in w2 run
  delete i in items where key i == items.key(2)

commit r2

commit w2 retry Serialization { txn: $W2, on: "" }
