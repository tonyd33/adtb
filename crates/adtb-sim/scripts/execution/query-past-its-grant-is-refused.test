# A query whose result exceeds its statement's memory grant is refused for the grant, and runs
# under the default grant.
use stocked
option query_memory_bytes 4096
reopen

error StatementLimit { limit: Memory { bytes: 4096 } }
  from s in stock select s

option query_memory_bytes default
reopen

query
  count(s for s in (from s in stock select s))
----
300
