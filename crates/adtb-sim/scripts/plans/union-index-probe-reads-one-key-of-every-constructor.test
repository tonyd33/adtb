# An equality on a field indexed over every constructor reads the entries of that key, of every
# constructor, as one probe; a probe of one constructor's relation yields only its rows.
use users

run
  insert identities.Apple { id: identities.key(3), user: users.key(1), sub: "s-ann" }
  insert identities.Google { id: identities.key(4), user: users.key(1), gid: "g-ann" }
  insert identities.EmailPass { id: identities.key(5), user: users.key(2), email: "b@x" }

probe plan
  explain from i in identities where i.user == users.key(1) select key i
----
Set total
  reads identities.EmailPass, identities.Google, identities.Apple, identities (user)
  Pipeline
    One row
    Probe identities (user)
      EmailPass ->
        Chain
          Emit
      Google ->
        Chain
          Emit
      Apple ->
        Chain
          Emit

query rowsort
  from i in identities where i.user == users.key(1) select i
----
Apple { id: identities.key(3), user: users.key(1), sub: "s-ann" }
EmailPass { id: identities.key(1), user: users.key(1), email: "a@x" }
Google { id: identities.key(4), user: users.key(1), gid: "g-ann" }

probe plan
  explain from i in identities.Google where i.user == users.key(1) select key i
----
Set total
  reads identities.EmailPass, identities.Google, identities.Apple, identities (user)
  Pipeline
    One row
    Probe identities (user)
      pruned EmailPass at compile, Apple at compile
      Google ->
        Chain
          Emit

query
  from i in identities.Google where i.user == users.key(1) select i.gid
----
"g-ann"
