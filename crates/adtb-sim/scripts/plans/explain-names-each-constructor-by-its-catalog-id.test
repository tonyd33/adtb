# The `ctor` of an arm and of a pruned constructor of an explain is the constructor's catalog id.
use users

query rowsort
  from c in catalog::constructors where c.name == "EmailPass" or c.name == "Google" or c.name == "Apple" select { n: c.name, id: c.id }
----
{ id: constructors.key(1028), n: "EmailPass" }
{ id: constructors.key(1029), n: "Google" }
{ id: constructors.key(1030), n: "Apple" }

plan
  explain from i in identities where i.user == users.key(2) select match i
    | EmailPass e -> e.email
    | Google g    -> g.gid
    | Apple a     -> a.sub
----
{"format": 1, "root": {"children": [{"arms": [
  {"name": "EmailPass", "ctor": 1028, "child": {}},
  {"name": "Google", "ctor": 1029, "child": {}},
  {"name": "Apple", "ctor": 1030, "child": {}}
]}]}}

plan
  explain from g in identities.Google where g.user == users.key(2) select g.gid
----
{"format": 1, "root": {"children": [{"pruned": [
  {"name": "EmailPass", "ctor": 1028, "stage": "compile"},
  {"name": "Apple", "ctor": 1030, "stage": "compile"}
]}]}}
