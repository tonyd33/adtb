# The auth schema and a constraint refusing blank names, opened with `names` pinned there, then
# reopened with the constraint dropped while `names` holds the drop pending.
use auth
log
  module auth
  add constraint no_blank = from u in users where u.name == "" select u
bundle web-1.0 pins 2 edition "2026-10" use names
reopen
bundle web-1.0 pins 2 edition "2026-10" use names
migrate
  module auth
  drop constraint no_blank
