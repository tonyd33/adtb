# A vacuum removes the pages it empties from the heap, leaving a hole at each position but the
# last, and later inserts fill the room it freed on the pages left and take the holes' positions.
use pages

run
  insert docs.Draft { id: 1, text: long::x1000() }

run
  insert docs from (from d in docs.Draft select Draft { id: d.id + 1, text: d.text })

run
  insert docs from (from d in docs.Draft select Draft { id: d.id + 2, text: d.text })

run
  insert docs from (from d in docs.Draft select Draft { id: d.id + 4, text: d.text })

run
  insert docs from (from d in docs.Draft select Draft { id: d.id + 8, text: d.text })

run
  insert docs from (from d in docs.Draft select Draft { id: d.id + 16, text: d.text })

probe heap app::docs Draft
----
0: HeapSlotted format 1, 7 slots
0.0: Normal NONE, x0
0.1: Normal NONE, x1
0.2: Normal NONE, x2
0.3: Normal NONE, x2
0.4: Normal NONE, x3
0.5: Normal NONE, x3
0.6: Normal NONE, x3
1: HeapSlotted format 1, 7 slots
1.0: Normal NONE, x3
1.1: Normal NONE, x4
1.2: Normal NONE, x4
1.3: Normal NONE, x4
1.4: Normal NONE, x4
1.5: Normal NONE, x4
1.6: Normal NONE, x4
2: HeapSlotted format 1, 7 slots
2.0: Normal NONE, x4
2.1: Normal NONE, x4
2.2: Normal NONE, x5
2.3: Normal NONE, x5
2.4: Normal NONE, x5
2.5: Normal NONE, x5
2.6: Normal NONE, x5
3: HeapSlotted format 1, 7 slots
3.0: Normal NONE, x5
3.1: Normal NONE, x5
3.2: Normal NONE, x5
3.3: Normal NONE, x5
3.4: Normal NONE, x5
3.5: Normal NONE, x5
3.6: Normal NONE, x5
4: HeapSlotted format 1, 4 slots
4.0: Normal NONE, x5
4.1: Normal NONE, x5
4.2: Normal NONE, x5
4.3: Normal NONE, x5

run
  delete d in docs where d.id > 2 and d.id < 22 or d.id > 25

run
  vacuum docs

probe heap app::docs Draft
----
0: HeapSlotted format 1, 2 slots, flagged all visible, mapped all visible
0.0: Normal NONE, x0
0.1: Normal NONE, x1
1: hole
2: hole
3: HeapSlotted format 1, 4 slots, flagged all visible, mapped all visible
3.0: Normal NONE, x2
3.1: Normal NONE, x2
3.2: Normal NONE, x2
3.3: Normal NONE, x2

run
  insert docs from (from d in docs.Draft select Draft { id: d.id + 100, text: d.text })

run
  insert docs from (from d in docs.Draft select Draft { id: d.id + 200, text: d.text })

run
  insert docs from (from d in docs.Draft select Draft { id: d.id + 400, text: d.text })

