# A split of a constructor into two products a set holds carries the set's index to both, by its id
# and the fields the carry maps, and a drop of the index by the set drops it.
seed 1
use empty

migrate
  module ts
  add module ts
  add type T { id: Key ts } = A { x: Text, y: Text, f: Bool } | B { k: Text }
  add relation ts : T key id generate sequence
  add set S of ts = A
  add index (y) in ts.S

migrate
  module ts
  split constructor T.A into A1 { x: Text, y: Text } | A2 { x: Text, y: Text }
    by match
      | A { x, y, f: true } -> A1 { x: y, y: x }
      | A { x, y, f: false } -> A2 { x: y, y: x }

query rowsort
  from r in catalog::relations, i in catalog::indexes
    where r.name == "ts" and i.relation == r.id select { id: i.id, clause: i.clause, dropped: i.dropped }
----
{ clause: "index (x) in (A1 | A2)", dropped: None, id: indexes.key(1025) }
{ clause: "key id", dropped: None, id: indexes.key(1024) }

migrate
  module ts
  drop index (x) in ts.S

query rowsort
  from r in catalog::relations, i in catalog::indexes
    where r.name == "ts" and i.relation == r.id select { id: i.id, clause: i.clause, dropped: i.dropped }
----
{ clause: "key id", dropped: None, id: indexes.key(1024) }
