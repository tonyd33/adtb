seed 7
use shop
use customers

migrate
  module shop
  add field Customer.vip: Bool fill false

query rowsort
  from c in customers select { name: c.name, vip: c.vip }
----
{ name: "ann", vip: False }
{ name: "bob", vip: False }

run
  insert customers { name: "cy", vip: true }

query rowsort
  from c in customers select { name: c.name, vip: c.vip }
----
{ name: "ann", vip: False }
{ name: "bob", vip: False }
