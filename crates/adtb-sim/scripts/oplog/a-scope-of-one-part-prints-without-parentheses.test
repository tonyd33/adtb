# A version prints the same text however its declarations wrote it: a unique scoped to one
# constructor written in parentheses prints that constructor bare.
seed 61

migrate
  module notes
  add module notes
  add type Note { id: Key notes, slug: Text, tag: Text } = Plain | Other
  add relation notes : Note key id generate sequence
  add unique (tag) in notes.(Plain)

command
  print schema
