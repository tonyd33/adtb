seed 92
use shop
use customers

migrate
  module shop
  define fn names () -> Set Text = from c in customers select c.name
  store names
  define fn sizes () -> Set I64 = from c in customers select count(d for d in customers)
  store sizes
  define fn references () -> Set (Key customers) = from c in customers select key c
  store references
  define fn nested () -> Set (Set Text) =
    from c in customers where c.name == "ann" select (from d in customers select d.name)
  store nested

query rowsort
  names()
----
"ann"
"bob"

query rowsort
  sizes()
----
2

query rowsort
  references()
----
customers.key(1)
customers.key(2)

query rowsort
  nested()
----
["ann", "bob"]

run
  insert customers { name: "cyril" }

reopen

query rowsort
  names()
----
"ann"
"bob"
"cyril"

query rowsort
  sizes()
----
3

query
  count(r for r in references())
----
3

query rowsort
  nested()
----
["ann", "bob", "cyril"]

query rowsort
  from r in catalog::relations where r.name == "names" select r.kind
