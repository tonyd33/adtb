seed 97
migrate
  module m
  add module m
  add type K = A | B
  add type T = A { x: Text } | B { x: Text } | C
  add type S = A { x: Text } | B { x: Text }
  add type Box a = A { x: a } | B { x: a } | C
  add type H = { id: Key hs, v: T, o: Option T, b: Box Text, i: Box I64 }
  add relation hs : H key id generate sequence

run
  transact
    insert hs { v: A { x: "a" }, o: Some { value: B { x: "b" } }, b: A { x: "c" }, i: B { x: 1 } }
    insert hs { v: B { x: "d" }, o: None, b: C, i: A { x: 2 } }
    insert hs { v: C, o: Some { value: A { x: "e" } }, b: B { x: "f" }, i: C }

migrate
  module m
  split constructor T.A into A1 { x: Text }
    by match
      | A { x } -> A1 { x: x }
  split constructor Box.A into A1 { x: a }
    by match
      | A { x } -> A1 { x: x }

query rowsort
  from h in hs select { v: h.v, o: h.o, b: h.b, i: h.i }
----
{ b: A1 { x: "c" }, i: B { x: 1 }, o: Some { value: B { x: "b" } }, v: A1 { x: "a" } }
{ b: C, i: A1 { x: 2 }, o: None, v: B { x: "d" } }
{ b: B { x: "f" }, i: C, o: Some { value: A1 { x: "e" } }, v: C }

