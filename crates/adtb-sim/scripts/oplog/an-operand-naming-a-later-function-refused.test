# A name an operator's operand writes resolves in the schema before the operator: a function a
# later operator of the migration defines is refused, whatever operand names it.
seed 1
use empty

migrate
  module app
  add module app
  add type K = A | B
  add type T { id: Key ts } = A { x: I64 } | B { x: I64 } | C { x: I64, y: I64 }
  add relation ts : T key id generate sequence
  add computed ts.d: I64 = 1

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "add default ts.A.x = h(1)", detail: "no `h` in scope" } } }
  module app
  add default ts.A.x = h(1)
  define fn h (x: I64) -> I64 = x

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "add computed ts.c: I64 = h(1)", detail: "no `h` in scope" } } }
  module app
  add computed ts.c: I64 = h(1)
  define fn h (x: I64) -> I64 = x

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "redefine computed ts.d: I64 = h(1)", detail: "no `h` in scope" } } }
  module app
  redefine computed ts.d: I64 = h(1)
  define fn h (x: I64) -> I64 = x

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "add field T.A.m: I64 fill h(1)", detail: "no `h` in scope" } } }
  module app
  add field T.A.m: I64 fill h(1)
  define fn h (x: I64) -> I64 = x

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "move field T.C.y to T fill match", detail: "no `h` in scope" } } }
  module app
  move field T.C.y to T fill match
    | A a -> h(1)
    | B b -> 2
  define fn h (x: I64) -> I64 = x

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "split constructor T.A into A1 { x: I64 } | A2 { x: I64 }", detail: "no `h` in scope" } } }
  module app
  split constructor T.A into A1 { x: I64 } | A2 { x: I64 }
    by match
      | A { x } -> if h(x) == 0 then A1 { x: x } else A2 { x: x }
  define fn h (x: I64) -> I64 = x

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "merge constructor T.(A | B) into M { k: K, x: I64 }", detail: "no `h` in scope" } } }
  module app
  merge constructor T.(A | B) into M { k: K, x: I64 }
    by match
      | A a -> M { k: A, x: h(a.x) }
      | B b -> M { k: B, x: b.x }
  define fn h (x: I64) -> I64 = x

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "add check k on ts.A (h(x) == 1)", detail: "no `h` in scope" } } }
  module app
  add check k on ts.A (h(x) == 1)
  define fn h (x: I64) -> I64 = x

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "add constraint k = from x in ts where h(1) == 0 select x.id", detail: "no `h` in scope" } } }
  module app
  add constraint k = from x in ts where h(1) == 0 select x.id
  define fn h (x: I64) -> I64 = x

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "define fn g (x: I64) -> I64 = h(x)", detail: "no `h` in scope" } } }
  module app
  define fn g (x: I64) -> I64 = h(x)
  define fn h (x: I64) -> I64 = x
