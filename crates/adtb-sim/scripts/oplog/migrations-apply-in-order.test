seed 2
use shop
use customers

migrate
  module shop
  add type Label = { id: Key labels, name: Text }
  add relation labels : Label key id generate sequence
  module shop
  rename relation customers to clients

run
  insert labels { name: "x" }

reopen

query rowsort
  from c in clients select c.name
----
"ann"
"bob"

query rowsort
  from t in labels select t.name
----
"x"
