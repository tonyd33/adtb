# Two elements are one expression apart from parentheses and module qualifiers: a unique or index
# whose elements differ from a held one's only so is refused as that one, and a drop written
# either way finds the held one.
seed 3

migrate
  module app
  add module app
  define fn f (x: I64) -> I64 = x * 2
  add type Item = { id: Key items, n: I64 }
  add relation items : Item key id generate sequence
  add unique (f(n)) in items
  add index (f(n)) in items

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "add unique (n) in items", detail: "`unique (n)` of `items` is one with `unique ((n))`, which `items` already holds" } } }
  module app
  add unique ((n)) in items
  add unique (n) in items

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "add index (((n))) in items", detail: "`index (((n)))` of `items` is one with `index (n)`, which `items` already holds" } } }
  module app
  add index (n) in items
  add index (((n))) in items

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "add unique (app::f(n)) in items", detail: "`unique (app::f(n))` of `items` is one with `unique (f(n))`, which `items` already holds" } } }
  module app
  add unique (app::f(n)) in items

migrate refused MigrationRefused { version: 2, reason: Rejected { reason: SchemaRefused { operator: "add index ((app::f(n))) in items", detail: "`index ((app::f(n)))` of `items` is one with `index (f(n))`, which `items` already holds" } } }
  module app
  add index ((app::f(n))) in items

migrate
  module app
  drop unique (app::f(n)) in items
  drop index ((f(n))) in items

query rowsort
  from r in catalog::relations, i in catalog::indexes
    where r.name == "items" and i.relation == r.id and i.dropped == None select i.clause
