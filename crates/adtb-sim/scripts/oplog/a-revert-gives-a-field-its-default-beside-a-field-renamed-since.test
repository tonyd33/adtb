# A revert of `drop field` or of `remove constructor` gives the field back its default when a
# field that had the same default was renamed since.
seed 1
use empty

migrate
  module ts
  add module ts
  add type T { id: Key ts } = A { n: Text } | B { n: Text }
  add relation ts : T key id generate sequence
  add default ts.n = "d"

migrate
  module ts
  drop field T.A.n

migrate
  module ts
  rename field T.B.n to p

migrate
  module ts
  revert 0002
    fill T.A.n = "x"

query rowsort
  from d in catalog::defaults, f in catalog::fields.Payload, c in catalog::constructors
    where d.field == f.id and f.ctor == c.id and d.dropped == None select { c: c.name, f: f.name, t: d.text }
----
{ c: "A", f: "n", t: "\"d\"" }
{ c: "B", f: "p", t: "\"d\"" }

migrate
  module ts
  add type U { id: Key us } = E { n: Text } | F { n: Text }
  add relation us : U key id generate sequence
  add default us.n = "d"

migrate
  module ts
  deprecate us.E

migrate
  module ts
  remove constructor U.E

migrate
  module ts
  rename field U.F.n to p

migrate
  module ts
  revert 0007

migrate
  module ts
  enable us.E

query rowsort
  from d in catalog::defaults, f in catalog::fields.Payload, c in catalog::constructors
    where d.field == f.id and f.ctor == c.id and d.dropped == None select { c: c.name, f: f.name, t: d.text }
----
{ c: "A", f: "n", t: "\"d\"" }
{ c: "B", f: "p", t: "\"d\"" }
{ c: "E", f: "n", t: "\"d\"" }
{ c: "F", f: "p", t: "\"d\"" }

reopen

run
  insert ts.A {}
  insert ts.B {}
  insert us.E {}
  insert us.F {}

query rowsort
  from t in ts select { id: t.id, v: match t | A a -> a.n | B b -> b.p }
----
{ id: ts.key(1), v: "d" }
{ id: ts.key(2), v: "d" }

query rowsort
  from t in us select { id: t.id, v: match t | E e -> e.n | F f -> f.p }
----
{ id: us.key(1), v: "d" }
{ id: us.key(2), v: "d" }
