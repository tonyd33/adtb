#!/usr/bin/env bash
# vacuity [REVSET]           run cargo-mutants over the diff of REVSET (default main..@) in the
#                            workspace holding the working directory, and write its record
# vacuity --check [REVSET]   fail unless the record of REVSET answers every mutant of its diff
#
# The record is work/vacuity/CHANGE.tsv, CHANGE the change id of the one non-empty head of REVSET.
# Its first line is `hash HASH`, HASH the sha256 of the diff of REVSET outside docs/, work/ and
# Markdown, with one line of context and no line numbers or index lines. Each other line is a
# mutant, `FILE FUNCTION MUTATION ORDINAL OUTCOME REASON` separated by tabs, FILE normalised,
# ORDINAL counting the alike mutants of the function in source order, OUTCOME one of caught,
# missed, unviable and timeout. Write on each missed or timeout line the reason no test can tell
# the mutant from the code. A changed Rust file that adds lines, is known to cargo-mutants or lies
# under src/, and has no mutant is named in its workspace's line `none WORKSPACE FILES REASON`;
# write why its additions need no mutant. A run keeps the reasons of a record of the same hash.
#
# --check lists the diff's mutants without building and fails when the hash differs, a mutant
# or `none` line is missing, a line matches nothing listed, a reason is blank, or a `none` line
# names a file with mutants. A REVSET with no commit that code-commits counts passes with no
# record. The working copy must hold the head's tree. Each cargo workspace holding a Rust file of
# the diff is listed and run on its own.
#
# A run tests the mutated packages, their workspace dependents with integration tests, and
# adtb-sim when check-reach finds the diff in its reach. It mutates the sources in place, builds
# into the workspace's target, takes CARGO_BUILD_JOBS and NEXTEST_TEST_THREADS from the
# environment and holds the machine lock throughout. Run no jj command in the workspace
# meanwhile: a snapshot would commit a mutated source. Until a run ends, target/vacuity-running
# names the sources to restore, and every call refuses.
# A site of the adtb-mutant macro hides the operators of its arguments: cargo-mutants replaces
# only the whole call.
set -euo pipefail
shopt -s inherit_errexit

tools=$(cd "$(dirname "$0")" && pwd)
check=
if [[ ${1:-} == --check ]]; then
  check=1
  shift
fi
rev=${1:-main..@}
root=$(jj --color=never workspace root)
cd "$root"
# shellcheck source=work/tools/common.bash
source "$tools/common.bash"

die() {
  printf 'vacuity: %s\n' "$1" >&2
  exit 1
}

guard=target/vacuity-running
if [[ -f $guard ]]; then
  die "a run was cut off; restore with: jj restore --from $(paste -sd' ' "$guard"), then rm $guard"
fi
commits=$(jj --color=never log --no-graph -r "$rev" -T 'commit_id ++ "|"')
commits=${commits%|}
code=
if [[ -n $commits ]]; then
  code=$("$tools/code-commits" "$commits")
fi
if [[ -z $code ]]; then
  [[ -z $check ]] || { echo "vacuity: no code change in $rev"; exit 0; }
  die "no code change in $rev"
fi
head=$(jj --color=never log --no-graph -r "heads(($commits) & ~empty())" -T 'change_id ++ "\n"')
heads=$(wc -l <<<"$head")
[[ $heads == 1 ]] || die "$rev has more than one non-empty head: $(paste -sd' ' <<<"$head")"
record=work/vacuity/$head.tsv
out=${CARGO_TARGET_DIR:-$root/target}/vacuity
mkdir -p "$out"
hash=$(jj --color=never diff --git --context 1 -r "$commits" '~(glob:"docs/**" | glob:"work/**" | glob:"**/*.md")' |
  sed -E -e 's/^@@ [^@]* @@/@@/' -e '/^index /d' | sha256sum | cut -d' ' -f1)
changed=$(jj --color=never diff --name-only -r "$commits" 'glob:"**/*.rs"')

# Print the directory of the cargo workspace holding path $1, `.` for the root's.
workspace_of() {
  local dir=$1
  while dir=$(dirname "$dir") && [[ $dir != . ]]; do
    if grep -qx '\[workspace\]' "$dir/Cargo.toml" 2>/dev/null; then
      echo "$dir"
      return
    fi
  done
  echo .
}

spaces=$(for f in $changed; do workspace_of "$f"; done | LC_ALL=C sort -u)

# Print the files of the diff in workspace $1, relative to the repository root.
files_of() {
  local f
  for f in $changed; do
    [[ $(workspace_of "$f") != "$1" ]] || echo "$f"
  done
}

# Print `NORMAL SPELLED` for each source file cargo-mutants knows in workspace $1: its path from
# the repository root, normalised, and cargo-mutants' spelling of it, relative to the workspace.
spellings() {
  local spelled normal
  spelled=$(cargo mutants --dir "$1" --list-files --json | jq -r '.[].path')
  [[ -n $spelled ]] || return 0
  # shellcheck disable=SC2086 # paths without spaces
  normal=$(cd "$1" && realpath -m --relative-to="$root" $spelled)
  paste <(echo "$normal") <(echo "$spelled")
}

# Print the record lines, without reasons, of workspace $1's cargo-mutants mutants on stdin, each
# with an optional `outcome`, its files normalised by the spellings in file $2.
keyed() {
  jq -r --arg w "$1" --rawfile s "$2" '($s | split("\n") | map(select(. != "") | split("\t") | {(.[1]): .[0]}) | add // {}) as $n
    | map({f: ($n[.file] // (if $w == "." then .file else $w + "/" + .file end)),
      fn: (.function.function_name // ""), m: (.name | sub("^[^:]*:[0-9]+:[0-9]+: "; "")),
      at: [.span.start.line, .span.start.column], outcome})
    | group_by([.f, .fn, .m]) | map(sort_by(.at) | to_entries | map(.value + {o: (.key + 1)})) | add // []
    | .[] | [.f, .fn, .m, .o] + (if .outcome then [.outcome] else [] end) | map(tostring) | join("\t")'
}

# Write the patch of workspace $1 to $2 in cargo-mutants' spelling, its spellings to $2.map, and
# print the keys of its mutants and its `none` line without a reason.
listed() {
  local w=$1 patch=$2 json files keys f added uncovered=
  files=$(files_of "$w")
  spellings "$w" >"$patch.map"
  # shellcheck disable=SC2086 # paths without spaces
  jj --color=never diff --git -r "$commits" $files | awk -v w="$w" -v map="$patch.map" '
    BEGIN { while ((getline line < map) > 0) { split(line, f, "\t"); s[f[1]] = f[2] } }
    /^(diff --git|---|\+\+\+) / {
      n = split($0, part, " ")
      for (i = 1; i <= n; i++) {
        p = substr(part[i], 3)
        if (part[i] !~ /^[ab]\//) continue
        if (p in s) part[i] = substr(part[i], 1, 2) s[p]
        else if (w != "." && index(p, w "/") == 1) part[i] = substr(part[i], 1, 2) substr(p, length(w) + 2)
      }
      $0 = part[1]
      for (i = 2; i <= n; i++) $0 = $0 " " part[i]
    }
    { print }' >"$patch"
  json=$(cargo mutants --dir "$w" --list --json --in-diff "$patch" 2>"$out/list.err") ||
    die "cargo mutants --list failed in $w: $(cat "$out/list.err")"
  ! grep -q 'Diff file is empty' "$out/list.err" || die "cargo-mutants read the diff of $w as empty"
  keys=$(keyed "$w" "$patch.map" <<<"${json:-[]}")
  for f in $files; do
    [[ -f $f ]] || continue
    if ! cut -f1 "$patch.map" | grep -qxF "$f" && [[ $f != src/* && $f != */src/* ]]; then
      continue
    fi
    ! cut -f1 <<<"$keys" | grep -qxF "$f" || continue
    added=$(jj --color=never diff --git -r "$commits" "$f" | awk '/^\+\+\+ / { next } /^\+/ { n++ } END { print n + 0 }')
    [[ $added == 0 ]] || uncovered+=" $f"
  done
  [[ -z $keys ]] || echo "$keys"
  [[ -z $uncovered ]] || printf 'none\t%s\t%s\n' "$w" "${uncovered# }"
}

if [[ -n $check ]]; then
  differs=$(jj --color=never diff --summary --from "$head" --to @)
  [[ -z $differs ]] || die "the working copy differs from $head"
  [[ -f $record ]] || die "no record $record for $rev; run vacuity"
  first=$(head -1 "$record")
  [[ $first == "hash"$'\t'"$hash" ]] || die "$record measured other code than $rev holds; run vacuity"
  want=
  for w in $spaces; do
    keys=$(listed "$w" "$out/check.patch")
    want+=$keys$'\n'
  done
  want=$(sed '/^$/d' <<<"$want" | LC_ALL=C sort)
  body=$(tail -n +2 "$record")
  have=$(awk -F'\t' -v OFS='\t' '{ print $1 == "none" ? $1 OFS $2 OFS $3 : $1 OFS $2 OFS $3 OFS $4 }' <<<"$body" | LC_ALL=C sort)
  failed=
  report() {
    [[ -n $2 ]] || return 0
    printf 'vacuity: %s:\n%s\n' "$1" "$2" >&2
    failed=1
  }
  missing=$(LC_ALL=C comm -23 <(echo "$want") <(echo "$have") | sed '/^$/d')
  stale=$(LC_ALL=C comm -13 <(echo "$want") <(echo "$have") | sed '/^$/d')
  bare=$(awk -F'\t' '($5 == "missed" || $5 == "timeout") && $6 !~ /[^[:space:]]/ || $1 == "none" && $4 !~ /[^[:space:]]/' <<<"$body")
  beside=$(awk -F'\t' '$1 != "none" { mutated[$1] = 1; next } { none[NR] = $0; files[NR] = $3 }
    END { for (i in none) { n = split(files[i], f, " "); for (j = 1; j <= n; j++) if (f[j] in mutated) { print none[i]; break } } }' <<<"$body")
  unknown=$(awk -F'\t' 'NF && $1 != "none" && $5 !~ /^(caught|missed|unviable|timeout)$/' <<<"$body")
  report "mutants or none lines of the diff with no line in $record" "$missing"
  report "lines of $record matching nothing the diff lists" "$stale"
  report "lines of $record with a blank reason" "$bare"
  report "none lines of $record naming a file with mutants" "$beside"
  report "lines of $record with an outcome other than caught, missed, unviable or timeout" "$unknown"
  [[ -z $failed ]] || exit 1
  echo "vacuity: $record answers every mutant of $rev"
  exit 0
fi

at=$(jj --color=never log --no-graph -r @ -T 'change_id ++ " " ++ commit_id')
[[ ${at% *} == "$head" ]] || die "make $head the working copy first: jj edit $head"
mkdir -p work/vacuity target
lines=$(mktemp)
no_core_dumps
machine_lock "$root"
for w in $spaces; do
  name=${w//\//-}
  [[ $w != . ]] || name=root
  keys=$(listed "$w" "$out/$name.patch")
  awk '/^none/' <<<"$keys" >>"$lines"
  mutants=$(awk 'NF && !/^none/' <<<"$keys")
  [[ -n $mutants ]] || continue
  mutated=$(cargo mutants --dir "$w" --list --json --in-diff "$out/$name.patch" | jq -c '[.[].package] | unique')
  metadata=$(cargo metadata --no-deps --format-version 1 --offline --manifest-path "$w/Cargo.toml")
  dependents=$(jq -r --argjson m "$mutated" '.packages[] | select(any(.dependencies[]; .path != null and (.name | IN($m[]))))
      | select(any(.targets[]; .kind == ["test"])) | .name' <<<"$metadata")
  sim=$(jq 'any(.packages[]; .name == "adtb-sim")' <<<"$metadata")
  reached=1
  [[ $w != . || $sim != true ]] || "$tools/check-reach" --reaches adtb-sim "$commits" >/dev/null || reached=$?
  [[ $reached == [01] ]] || die "check-reach failed: $reached"
  [[ $reached != 0 ]] || dependents+=$'\nadtb-sim'
  args=(--dir "$w" --in-place --in-diff "$out/$name.patch" --test-tool nextest --no-shuffle --output "$out/$name")
  for p in $(sed '/^$/d' <<<"$dependents" | LC_ALL=C sort -u); do
    args+=("--cargo-test-arg=--package=$p")
  done
  { echo "${at#* }"; files_of "$w"; } >"$guard"
  status=0
  cargo mutants "${args[@]}" || status=$?
  rm "$guard"
  [[ $status == [023] ]] || die "cargo mutants exited $status in $w; logs in $out/$name/mutants.out"
  jq '[.outcomes[] | select(.scenario | type == "object") | .scenario.Mutant + {outcome:
      ({CaughtMutant: "caught", MissedMutant: "missed", Unviable: "unviable", Timeout: "timeout"}[.summary]
        // "unknown \(.summary)")}]' "$out/$name/mutants.out/outcomes.json" | keyed "$w" "$out/$name.patch.map" >>"$lines"
done
machine_unlock
unknown=$(awk -F'\t' '$5 ~ /^unknown /' "$lines")
[[ -z $unknown ]] || die "cargo-mutants gave outcomes vacuity does not know:"$'\n'"$unknown"
old=
if [[ -f $record ]]; then
  first=$(head -1 "$record")
  [[ $first != "hash"$'\t'"$hash" ]] || old=$record
fi
{
  printf 'hash\t%s\n' "$hash"
  LC_ALL=C sort "$lines" | awk -F'\t' -v OFS='\t' -v old="$old" '
    function key(a, b, c, d) { return a == "none" ? a FS b FS c : a FS b FS c FS d }
    BEGIN { while (old != "" && (getline line < old) > 0) { split(line, f, "\t"); reason[key(f[1], f[2], f[3], f[4])] = f[1] == "none" ? f[4] : f[6] } }
    { print $0, reason[key($1, $2, $3, $4)] }'
} >"$out/record.new"
rm "$lines"
mv "$out/record.new" "$record"
echo "vacuity: wrote $record"
awk -F'\t' '$1 == "none" || $5 == "missed" || $5 == "timeout"' "$record"
