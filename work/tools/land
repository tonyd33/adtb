#!/usr/bin/env bash
# land WS [SUBJECT]   land workspace WS on top of the main checkout's parent commit: snapshot WS,
#                     rebase its commits, describe its working-copy commit as SUBJECT, move the
#                     `main` bookmark and the main working copy onto it, and forget WS
#
# Refuses before changing anything when the main working copy has changes, WS is unknown, a
# commit to land has no description or WS holds a file jj does not track that the repository's
# .gitignore files do not ignore.
# Refuses after the rebase when a landed commit has conflicts; the rebased commits stay in WS for
# its agent to fix. Leaves WS's directory in place. A workspace taken with `slot` is not
# forgotten: its directory becomes a free slot, its working copy an empty commit on the landed
# tip, its name `slot-N`. Refuses a slot in use by a process, and leaves main unmoved when a file
# written during land strands work in a divergent commit.
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
ws=${1:?usage: land WS [SUBJECT]}
subject=${2:-}

# shellcheck source=work/tools/common.bash
source "$root/work/tools/common.bash"

die() {
  printf 'land: %s\n' "$1" >&2
  exit 1
}

# Prints the root of the workspace named $1.
workspace_root() {
  jj -R "$root" workspace list --ignore-working-copy -T 'name ++ "\t" ++ root ++ "\n"' |
    awk -F'\t' -v name="$1" '$1 == name { print $2 }'
}

# Prints the files of workspace root $1 that jj does not track and no .gitignore of the repository
# ignores.
unignored_untracked() {
  local gitdir
  gitdir=$(jj -R "$1" git root)
  awk 'NR == FNR { tracked[$0] = 1; next } !($0 in tracked)' \
    <(jj -R "$1" file list -T 'path ++ "\n"') \
    <(GIT_INDEX_FILE="$1/.jj/no-index" git --git-dir="$gitdir" --work-tree="$1" \
      ls-files -z --others --exclude-per-directory=.gitignore | tr '\0' '\n') | LC_ALL=C sort
}

# Prints $1 as a fileset naming that one file from the workspace root.
root_file() {
  local quoted=${1//\\/\\\\}
  printf 'root-file:"%s"' "${quoted//\"/\\\"}"
}

main=$(workspace_root default)
wsroot=$(workspace_root "$ws")
[[ -n $wsroot ]] || die "no workspace named $ws"
[[ $ws != default ]] || die "cannot land the default workspace"
! free_slot "$ws" "$wsroot" "$main" || die "$ws is a free slot, with nothing to land"

slot=slot-${wsroot##*-slot-}
free_slot "$slot" "$wsroot" "$main" || slot=
if [[ -n $slot ]]; then
  users=$(pids_using "$wsroot")
  [[ -z $users ]] || die "$wsroot is in use by: $(echo "$users" | paste -sd,)"
fi

jj -R "$wsroot" status

hidden=$(unignored_untracked "$wsroot")
if [[ -n $hidden ]]; then
  command=(jj -R "$wsroot" file track --include-ignored)
  while IFS= read -r file; do
    command+=("$(root_file "$file")")
  done <<<"$hidden"
  printf 'land: files jj does not track and the repository'"'"'s .gitignore files do not ignore:\n' >&2
  while IFS= read -r file; do
    printf '  %s\n' "$file" >&2
  done <<<"$hidden"
  printf 'land: track them with the command below, or delete them if the track does not need them:\n' >&2
  printf '%q ' "${command[@]}" >&2
  printf '\n' >&2
  exit 1
fi

pending=$(jj -R "$main" diff --summary)
if [[ -n $pending ]]; then
  printf '%s\n' "$pending" >&2
  die "the main working copy has changes; describe them and run jj new first"
fi

tip="$ws@"
if [[ -z $(jj -R "$main" log -r "$ws@ & ~empty() | $ws@ & ~description(exact:'')" --no-graph -T 'change_id') ]]; then
  tip="$ws@-"
elif [[ -n $subject ]]; then
  jj -R "$main" describe -r "$ws@" -m "$subject"
fi
undescribed=$(jj -R "$main" log -r "(@-..$tip) & description(exact:'')" --no-graph -T 'change_id.short() ++ "\n"')
[[ -z $undescribed ]] || die "no description on $(echo $undescribed); pass SUBJECT or describe them"

jj -R "$main" rebase -b "$ws@" -d @-

conflicted=$(jj -R "$main" log -r "(@-..$tip) & conflicts()" --no-graph -T 'change_id.short() ++ "\n"')
[[ -z $conflicted ]] || die "conflicts in $(echo $conflicted); send them back to the agent in $ws"

if [[ -n $slot ]]; then
  change=$(jj -R "$main" log -r "$ws@" --no-graph -T 'change_id')
  jj -R "$wsroot" workspace update-stale
  stranded=$(jj -R "$main" log -r "divergent() & change_id($change)" --no-graph -T 'commit_id.short() ++ " "')
  [[ -z $stranded ]] || die "main did not move; work written during land is in divergent commits: $stranded"
fi

old=$(jj -R "$main" log -r @ --no-graph -T 'change_id')
jj -R "$main" new "$tip"
if [[ -n $(jj -R "$main" log -r "present($old)" --no-graph -T 'change_id') ]]; then
  jj -R "$main" abandon "$old"
fi
jj -R "$main" bookmark set main -r @-
if [[ -n $slot ]]; then
  jj -R "$wsroot" new "$tip"
  jj -R "$wsroot" workspace rename "$slot"
else
  jj -R "$main" workspace forget "$ws"
fi
jj -R "$main" log -r '@-|@' --no-graph -T 'change_id.short() ++ " " ++ description.first_line() ++ "\n"'
if [[ -n $slot ]]; then
  printf 'land: run check; %s is free at %s\n' "$slot" "$wsroot"
else
  printf 'land: run check, then remove %s\n' "$wsroot"
fi
