#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$root"
action=${1:-build}
if (($#)); then shift; fi
case "$action" in
  build) exec mdbook build "$@" ;;
  serve) exec mdbook serve "$@" ;;
  check)
    mdbook build
    site=$root/target/docs-site/html
    exec lychee --offline --include-fragments --no-progress --root-dir "$site" "$site"
    ;;
  *) echo 'usage: docs-site [build|serve|check] [mdBook options]' >&2; exit 2 ;;
esac
