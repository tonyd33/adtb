#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$root"
export PYTHONDONTWRITEBYTECODE=1
action=${1:-build}
if (($#)); then shift; fi
case "$action" in
  build) exec mdbook build "$@" ;;
  serve) exec mdbook serve "$@" ;;
  check) exec python3 -B tools/docs-site/check.py "$@" ;;
  *) echo 'usage: docs-site [build|serve|check] [mdBook options]' >&2; exit 2 ;;
esac
