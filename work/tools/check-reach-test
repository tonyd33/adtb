#!/usr/bin/env bash
set -euo pipefail

reach=${1:-$(cd "$(dirname "$0")" && pwd)/check-reach}

# Fail unless the plan for the `jj diff --summary` line $1 has the verdicts `run PART` or
# `skip PART` of $2...
expect() {
  local line=$1 plan want
  shift
  plan=$(printf '%s\n' "$line" | "$reach" --summary 2>/dev/null)
  for want in "$@"; do
    if ! grep -qE "^$want(:|$)" <<<"$plan"; then
      printf 'check-reach-test: %s: expected %s in\n%s\n' "$line" "$want" "$plan" >&2
      exit 1
    fi
  done
}

expect "M crates/adtb/src/lib.rs" 'skip miri' 'skip loom' 'skip tree-sitter' 'run campaign' 'skip docs'
expect "M crates/adtb-sys/src/lib.rs" 'run miri' 'run loom' 'run campaign' 'skip tree-sitter'
expect "M apps/campaign/src/main.rs" 'run campaign' 'run tree-sitter' 'skip miri' 'skip loom'
expect "M crates/adtb-bench/src/lib.rs" 'skip campaign' 'skip miri' 'skip tree-sitter'
expect "M crates/adtb-lang/src/lex.rs" 'run tree-sitter' 'run campaign' 'skip miri'
expect "M docs/SUMMARY.md" 'run docs' 'skip tree-sitter' 'skip campaign'
expect "M work/tools/land" 'run slot-test' 'skip suite-test' 'skip house-check-test'
expect "M work/tools/common.bash" 'run slot-test' 'run suite-test' 'skip house-check-test'
expect "M work/tools/structure-check" 'run structure-check-test' 'skip slot-test' 'skip house-check-test'
expect "M work/tools/structure-allowlist" 'run structure-check-test' 'skip slot-test'
expect "M work/tools/feature-check" 'run feature-check-test' 'skip slot-test' 'skip structure-check-test'
expect "M crates/adtb-structure/src/main.rs" 'run structure-check-test' 'skip slot-test'
expect "M clippy.toml" 'run structure-check-test'
expect "M Cargo.lock" 'run miri' 'run loom' 'run campaign' 'run tree-sitter' 'run docs' 'run deny'
expect "M clippy.toml" 'run miri' 'run loom' 'run campaign' 'run tree-sitter' 'run docs'
expect "A tools/docs-site/adt-highlight.js" 'run docs' 'skip campaign'
expect "R {crates/adtb-sys/src/a.rs => crates/adtb/src/a.rs}" 'run miri' 'run loom' 'run campaign'
expect "R crates/{adtb => adtb-bench}/src/a.rs" 'run campaign' 'skip miri'
expect "M crates/adtb/Cargo.toml" 'run check-reach-test' 'run deny' 'skip miri'
expect "M crates/adtb/src/storage/pager.rs" 'run damage-search' 'skip miri'
expect "M crates/adtb/src/heap/dir.rs" 'run damage-search'
expect "M crates/adtb-sim/tests/storage/damage_search/judge.rs" 'run damage-search'
expect "M crates/adtb/src/write/quarantine.rs" 'run damage-search'
expect "M crates/adtb/src/api/mod.rs" 'run damage-search'
expect "M crates/adtb/src/api/maintenance.rs" 'run damage-search'
expect "M crates/adtb-testkit/src/profile.rs" 'run damage-search'
expect "M crates/adtb/src/exec/store.rs" 'run damage-search'
expect "M crates/adtb/src/exec/mod.rs" 'skip damage-search'
expect "M crates/adtb-lang/src/lex.rs" 'skip damage-search'
expect "M .config/nextest.toml" 'run damage-search'
printf 'check-reach cases passed\n'

