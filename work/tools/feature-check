#!/usr/bin/env bash
# feature-check [DIR]   fail when, in the repository at DIR (default this one), a package of the
#                       root workspace or of a workspace under apps/ has a normal or build
#                       dependency on adtb or adtb-lang with its `testing` feature, enables
#                       `adtb/testing` or `adtb-lang/testing` from a feature of its own (adtb's
#                       `testing` may enable `adtb-lang/testing`), or when the default features of
#                       either include `testing`. Dev-dependencies may enable it. Fail as well
#                       when a package other than adtb-lang depends on a regular expression
#                       crate (regex, regex-automata, regex-syntax, regex-lite, fancy-regex): a
#                       `matches` pattern compiles only through adtb-lang.
set -euo pipefail

root=$(cd "${1:-$(dirname "$0")/../..}" && pwd)
manifests=("$root/Cargo.toml")
for app in "$root"/apps/*/Cargo.toml; do
  [[ ! -f $app ]] || manifests+=("$app")
done

found=
bad=
for manifest in "${manifests[@]}"; do
  metadata=$(cargo metadata --no-deps --offline --format-version 1 --manifest-path "$manifest")
  found+=$(jq -r '.packages[] | select(.name == "adtb") | .name' <<<"$metadata")
  out=$(jq -r --arg root "$root/" '
    ["adtb", "adtb-lang"] as $gated
    | .packages[]
    | (.manifest_path | ltrimstr($root)) as $at
    | .name as $package
    | ( .dependencies[]
        | select((.name | IN($gated[])) and .kind != "dev" and any(.features[]; . == "testing"))
        | "\($at): a \(.kind // "normal") dependency on \(.name) enables testing" ),
      ( .features | to_entries[]
        | .key as $feature
        | .value[]
        | capture("^(?<dep>[a-z-]+)\\??/testing$")?
        | select(.dep | IN($gated[]))
        | select(($package == "adtb" and $feature == "testing" and .dep == "adtb-lang") | not)
        | "\($at): feature \($feature) enables \(.dep)/testing" ),
      ( select(.name | IN($gated[])) | .features.default // [] | select(any(.[]; . == "testing"))
        | "\($at): the default features include testing" ),
      ( select($package != "adtb-lang") | .dependencies[]
        | select(.name | IN("regex", "regex-automata", "regex-syntax", "regex-lite", "fancy-regex"))
        | "\($at): a \(.kind // "normal") dependency on \(.name), which only adtb-lang compiles patterns with" )
    | "feature-check: " + .' <<<"$metadata")
  [[ -z $out ]] || bad+=$out$'\n'
done
[[ -n $found ]] || { echo "feature-check: no package adtb under $root" >&2; exit 1; }
[[ -z $bad ]] || { printf '%s' "$bad"; exit 1; }
