#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'HELP'
limited COMMAND [ARGS]   run COMMAND in a systemd user scope of its own, adtb-run-NAME-PID.scope
                         under adtb.slice, NAME the file name of COMMAND

The scope holds at most 14G. adtb.slice, every run together, is throttled past 60% of the
machine's memory and holds at most 75%. Neither swaps. Past a limit the kernel kills a process
under it and the run goes on. With no systemd user manager, COMMAND runs as it is with
ADTB_UNLIMITED=1, and says so.
HELP
}

case ${1:--h} in
  -h | --help)
    usage
    exit 2
    ;;
esac

if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "limited: no systemd user manager, so $1 runs without a memory limit" >&2
  ADTB_UNLIMITED=1 exec "$@"
fi
systemctl --user set-property --runtime adtb.slice MemoryHigh=60% MemoryMax=75% MemorySwapMax=0
exec systemd-run --user --scope --quiet --collect --slice=adtb.slice --unit="adtb-run-${1##*/}-$$" \
  -p MemoryMax=14G -p MemorySwapMax=0 -p OOMPolicy=continue -- "$@"
