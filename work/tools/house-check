#!/usr/bin/env bash
# house-check [DIR [JJ-DIFF-ARGS...]]   print each added line of `jj diff` in the workspace at DIR
#                                       that breaks a house rule, as FILE:LINE: RULE: TEXT
#
# DIR defaults to the workspace holding this script.
# Rules: an em dash anywhere; in Rust comments, markdown bold, a section sign, a rule id
# or a recognized third-person doc verb. List added ordinary comments for invariant review.
# Pass `-r REV` or
# `--from A --to B` to check other changes than the working copy's. Exits 1 when it prints.
set -euo pipefail

cd "${1:-$(dirname "$0")/../..}"
shift || true

jj diff --git "$@" | awk '
  BEGIN {
    split("adds appends applies asserts binds builds calls checks chooses classifies clones closes collects commits compares compiles consumes " \
          "continues converts copies counts creates decides decodes deletes derives draws elaborates emits encodes ends evaluates fails finds " \
          "flattens folds follows generates gives inserts judges keeps latches loads maps matches merges moves nests normalises normalizes " \
          "notes opens parses panics plans prepares prints processes puts reads records refuses rejects removes renames renders replaces " \
          "resolves retypes rewrites runs scans sets skips splits stores subtracts sweeps synthesises synthesizes takes undoes unnests updates " \
          "vacuums validates visits waits walks wraps writes", words)
    for (i in words) verbs[words[i]] = 1
  }
  /^\+\+\+ / { file = substr($0, 7); next }
  /^@@ / {
    split($3, hunk, ",")
    line = substr(hunk[1], 2) - 1
    next
  }
  /^-/ { next }
  /^ / { line++; next }
  /^\+/ {
    line++
    text = substr($0, 2)
    if (index(text, "\342\200\224")) report("em dash")
    if (file !~ /\.rs$/) next
    at = match(text, /(^|[ \t])\/\//)
    if (!at) next
    comment = substr(text, at)
    sub(/^[ \t]*/, "", comment)
    if (comment ~ /\*\*/) report("bold in a comment")
    if (comment ~ /§/) report("section sign in a comment")
    bare = comment
    gsub(/UTF-(8|16|32)/, "", bare)
    if (bare ~ /(^|[^A-Za-z0-9_])[A-Z][A-Z]+-[A-Z0-9][A-Z0-9-]*/) report("rule id in a comment")
    if (comment ~ /^\/\/[\/!]/) {
      doc = comment
      sub(/^\/\/[\/!][ \t]*/, "", doc)
      split(tolower(doc), words, /[^a-z]+/)
      if (words[1] in verbs && !noun(tolower(doc))) report("third-person doc verb")
    } else report("comment, keep only for an invariant")
  }
  function noun(doc) {
    if (doc !~ /^(appends|builds|calls|checks|clones|counts|inserts|latches|loads|maps|matches|notes|plans|processes|reads|records|runs|sets|waits|walks|writes)([^a-z]|$)/) return 0
    if (doc ~ /^[a-z]+([,:]| (of|and|or|per)([^a-z]|$))/) return 1
    if (doc ~ /^[a-z]+ (in|on|over|through) / && doc !~ / (into|to) /) return 1
    if (doc ~ /^(calls|counts|inserts|loads|maps|reads|runs|sets|walks|writes) (that|which|whose) /) return 1
    return doc ~ / (are|were) / && doc !~ / (that|which|whose) /
  }
  function report(rule) {
    printf "%s:%d: %s: %s\n", file, line, rule, text
    found = 1
  }
  END { exit found }
'
