#!/usr/bin/env bash
set -euo pipefail

checker=${1:-$(cd "$(dirname "$0")" && pwd)/structure-check}
clippy_toml=$(cd "$(dirname "$0")/../.." && pwd)/clippy.toml
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
cd "$scratch"
adtb=crates/adtb/src
mkdir -p work/tools "$adtb/storage" "$adtb/exec" crates/aa/src

fail() {
  printf 'structure-check-test: %s\n' "$1" >&2
  exit 1
}

# Succeed when the checker, given the allowlist lines $@, passes; fail otherwise.
passes() {
  printf '%s\n' '# header' "$@" >work/tools/structure-allowlist
  "$checker" "$scratch" >out.txt 2>&1 || fail "expected a pass, got: $(cat out.txt)"
  [[ ! -s out.txt ]] || fail "a pass printed: $(cat out.txt)"
}

# Require the checker to fail with the whole output $1 for the allowlist lines $2....
refuses() {
  local want=$1
  shift
  printf '%s\n' '# header' "$@" >work/tools/structure-allowlist
  if "$checker" "$scratch" >out.txt 2>&1; then
    fail "expected a refusal, got a pass for: $*"
  fi
  [[ $(cat out.txt) == "$want" ]] || fail "expected '$want', got: $(cat out.txt)"
}

# The ratchet: each row's sites are counted per file and must equal the file's allowlist line.
mkdir -p "$adtb/api"
printf '%s\n' 'fn f() { e.abort(id, tx)?; self.db.abort(tx).ok(); }' >"$adtb/api/base.rs"
printf 'fn allows() {}\n' >crates/aa/src/lib.rs
printf '#[expect(clippy::disallowed_methods, reason = "r")]\nfn a() {}\n#[expect(\n    clippy::disallowed_methods,\n    reason = "r"\n)]\nfn b() {}\n' >"$adtb/exec/b.rs"
printf '#![expect(clippy::disallowed_methods, reason = "r")]\n' >"$adtb/exec/b_tests.rs"

exact=(
  'api_aborts prod 2 crates/adtb/src/api/base.rs'
  'crash_allows prod 1 crates/aa/src/lib.rs'
  'disallowed_methods prod 2 crates/adtb/src/exec/b.rs'
  'disallowed_methods test 1 crates/adtb/src/exec/b_tests.rs'
)
passes "${exact[@]}"

# --counts prints the allowlist lines for the tree.
[[ $("$checker" --counts "$scratch") == "$(printf '%s\n' "${exact[@]}")" ]] ||
  fail "--counts printed: $("$checker" --counts "$scratch")"

# A rise in a listed file fails.
printf '%s\n' 'fn g() { e.abort(id, tx)?; }' >>"$adtb/api/base.rs"
refuses 'structure-check: api_aborts prod crates/adtb/src/api/base.rs has 3, allowed 2: remove the sites, do not raise the allowlist' "${exact[@]}"
sed -i '/^fn g/d' "$adtb/api/base.rs"
passes "${exact[@]}"

# A fall without an allowlist edit fails as stale; the lowered line passes; at 0 the line must go.
printf '%s\n' 'fn f() { e.abort(id, tx)?; }' >"$adtb/api/base.rs"
refuses 'structure-check: api_aborts prod crates/adtb/src/api/base.rs has 1, allowed 2: stale, lower the allowlist line to 1' "${exact[@]}"
passes 'api_aborts prod 1 crates/adtb/src/api/base.rs' "${exact[@]:1}"
printf 'fn q() {}\n' >crates/aa/src/lib.rs
refuses 'structure-check: crash_allows prod crates/aa/src/lib.rs has 0, allowed 1: stale, delete the allowlist line' 'api_aborts prod 1 crates/adtb/src/api/base.rs' "${exact[@]:1}"
passes 'api_aborts prod 1 crates/adtb/src/api/base.rs' "${exact[@]:2}"

# A site in a file with no line fails; a test file is counted against the test kind alone.
printf '%s\n' 'fn f() { e.abort(id, tx)?; }' >"$adtb/api/new.rs"
refuses 'structure-check: api_aborts prod crates/adtb/src/api/new.rs has 1, allowed 0: remove the sites, do not raise the allowlist' 'api_aborts prod 1 crates/adtb/src/api/base.rs' "${exact[@]:2}"
rm "$adtb/api/new.rs"
printf '#![expect(clippy::disallowed_methods, reason = "r")]\n#[expect(clippy::disallowed_methods, reason = "r")]\nfn t() {}\n' >"$adtb/exec/b_tests.rs"
refuses 'structure-check: disallowed_methods test crates/adtb/src/exec/b_tests.rs has 2, allowed 1: remove the sites, do not raise the allowlist' 'api_aborts prod 1 crates/adtb/src/api/base.rs' "${exact[@]:2}"

# An expect counts as test when an item, statement or expression on its path carries `cfg(test)` or
# `cfg(all(.., test, ..))`, or `cfg_attr(test, ..)` wraps it; any other form is prod. Only the lint
# list counts, not a `reason`, and a macro's tokens count where the parse cannot see.
cat >"$adtb/exec/c.rs" <<'RS'
#[expect(clippy::disallowed_methods, reason = "r")]
fn p() {}
#[cfg(all(test, not(loom)))]
#[expect(
    clippy::disallowed_methods,
    reason = "r"
)]
mod tests {
    #[test]
    fn t() {}
}
#[cfg(test)]
mod more {
    #[expect(clippy::disallowed_methods, reason = "r")]
    fn u() {}
}
#[cfg(test)]
#[expect(clippy::disallowed_methods, reason = "r")]
fn v() {}
#[cfg(not(test))]
#[expect(clippy::disallowed_methods, reason = "r")]
fn w() {}
#[cfg(any(test, loom))]
#[expect(clippy::disallowed_methods, reason = "r")]
fn x() {}
#[cfg(test)]
trait Tr {
    #[expect(clippy::disallowed_methods, reason = "r")]
    fn m() {}
}
fn blocks() {
    #[cfg(test)]
    {
        #[expect(clippy::disallowed_methods, reason = "r")]
        fn inner() {}
    }
    #[cfg(test)]
    let _l = {
        #[expect(clippy::disallowed_methods, reason = "r")]
        fn inner() {}
        1
    };
}
#[cfg_attr(test, expect(clippy::disallowed_methods, reason = "r"))]
fn ca() {}
#[cfg_attr(loom, expect(clippy::disallowed_methods, reason = "r"))]
fn cb() {}
#[expect(dead_code, reason = "clippy::disallowed_methods")]
fn named_in_reason() {}
macro_rules! m {
    () => {
        #[expect(clippy::disallowed_methods, reason = "r")]
        fn from_macro() {}
    };
}
proptest! {
    #[expect(clippy::disallowed_methods, reason = "r")]
    fn in_proptest() {}
}
RS
[[ $("$checker" --counts "$scratch") == "$(printf '%s\n' \
  'api_aborts prod 1 crates/adtb/src/api/base.rs' \
  'disallowed_methods prod 2 crates/adtb/src/exec/b.rs' \
  'disallowed_methods test 2 crates/adtb/src/exec/b_tests.rs' \
  'disallowed_methods prod 6 crates/adtb/src/exec/c.rs' \
  'disallowed_methods test 7 crates/adtb/src/exec/c.rs')" ]] || fail "--counts printed: $("$checker" --counts "$scratch")"
rm "$adtb/exec/c.rs"

# A mark set or held, and an index named as a mark or imported bare, count in production
# sources outside the policy table and the codec; a read of the marks and a test do not.
mkdir -p "$adtb/write"
printf 'use crate::storage::Quarantine::*;
fn f() {
    pager.quarantine(Quarantine::Index(3));
    self.marks().hold(rt, Quarantine::Database);
    self.marks()
        .change(rt, f);
    let object = storage::Quarantine::Index(4);
    if pager.is_quarantined(Quarantine::Index(5)) {}
    marks.contains(&Quarantine::Index(6));
}
' >"$adtb/write/q.rs"
for f in quarantine.rs policy.rs; do
  cp "$adtb/write/q.rs" "$adtb/storage/$f"
done
cp "$adtb/write/q.rs" "$adtb/write/q_tests.rs"
counts=$("$checker" --counts "$scratch")
for f in write/q.rs storage/quarantine.rs storage/policy.rs; do
  grep -qxF "mark_setters prod 3 crates/adtb/src/$f" <<<"$counts" || fail "not counted: mark_setters in $f: $counts"
done
grep -qxF 'index_marks prod 3 crates/adtb/src/write/q.rs' <<<"$counts" || fail "not counted: index_marks: $counts"
! grep -q 'index_marks .* crates/adtb/src/storage/\|\(mark_setters\|index_marks\) .*_tests.rs' <<<"$counts" ||
  fail "counted the policy table, the codec or a test: $counts"
rm -r "$adtb/write" "$adtb/storage/"{quarantine,policy}.rs

# A read of the database's mark counts in production sources outside storage and mvcc.
mkdir -p "$adtb/write" "$adtb/mvcc" "$adtb/storage"
printf 'fn f() {
    if pager.is_quarantined(Quarantine::Database) {}
    let whole = pager.is_quarantined(storage::Quarantine::Database);
    let crated = pager.is_quarantined(crate::storage::Quarantine::Database);
    let wrapped = pager.is_quarantined(
        crate::storage::Quarantine::Database,
    );
    self.db
        .admit_database()?;
    for object in std::iter::once(crate::storage::Quarantine::Database) {}
    pager.is_quarantined(Quarantine::Heap(1));
}
pub fn admit_database(&self) {}
' >"$adtb/write/q.rs"
for f in storage/q.rs mvcc/q.rs write/q_tests.rs; do
  cp "$adtb/write/q.rs" "$adtb/$f"
done
counts=$("$checker" --counts "$scratch")
grep -qxF 'marked_readers prod 6 crates/adtb/src/write/q.rs' <<<"$counts" || fail "not counted: marked_readers: $counts"
! grep -q 'marked_readers .* crates/adtb/src/\(storage\|mvcc\)/\|marked_readers .*_tests.rs' <<<"$counts" ||
  fail "counted storage, mvcc or a test: $counts"
rm -r "$adtb/write" "$adtb/mvcc" "$adtb/storage/q.rs"

# api_aborts counts `.abort(` in production sources of the api, not tests or other modules.
mkdir -p "$adtb/api" "$adtb/write"
printf '%s\n' 'fn f() { e.abort(id, tx)?; self.db.abort(tx).ok(); e.abandon(id, tx, || err); }' >"$adtb/api/a.rs"
cp "$adtb/api/a.rs" "$adtb/api/a_tests.rs"
cp "$adtb/api/a.rs" "$adtb/write/a.rs"
counts=$("$checker" --counts "$scratch")
grep -qxF 'api_aborts prod 2 crates/adtb/src/api/a.rs' <<<"$counts" || fail "not counted: api_aborts: $counts"
! grep -q 'api_aborts .*a_tests.rs\|api_aborts .*write/' <<<"$counts" || fail "counted a test or write: $counts"
rm -r "$adtb/api" "$adtb/write"

# A malformed allowlist line fails.
printf '%s\n' 'meta prod many crates/adtb/src/exec/a.rs' >work/tools/structure-allowlist
if "$checker" "$scratch" >out.txt 2>&1; then
  fail "expected a refusal of a bad allowlist line"
fi
grep -qxF 'structure-check: work/tools/structure-allowlist: bad line: meta prod many crates/adtb/src/exec/a.rs' out.txt ||
  fail "bad line not reported: $(cat out.txt)"

# A count above the base revision's allowlist fails, however the tree stands.
jj git init . >/dev/null 2>&1
printf '%s\n' '# header' 'api_aborts prod 5 crates/adtb/src/api/base.rs' 'crash_allows prod 4 crates/aa/src/lib.rs' >work/tools/structure-allowlist
jj file track --include-ignored work/tools/structure-allowlist >/dev/null 2>&1
jj describe -m base >/dev/null 2>&1
jj new >/dev/null 2>&1
printf '%s\n' '# header' 'api_aborts prod 5 crates/adtb/src/api/base.rs' 'crash_allows prod 3 crates/aa/src/lib.rs' >work/tools/structure-allowlist
"$checker" --against @- "$scratch" >out.txt 2>&1 || fail "a fall against the base refused: $(cat out.txt)"
printf '%s\n' '# header' 'api_aborts prod 6 crates/adtb/src/api/base.rs' 'crash_allows prod 3 crates/aa/src/lib.rs' >work/tools/structure-allowlist
if "$checker" --against @- "$scratch" >out.txt 2>&1; then
  fail "a raised count passed against the base"
fi
[[ $(cat out.txt) == 'structure-check: api_aborts prod crates/adtb/src/api/base.rs allows 6, the allowlist at the base allows 5: a rise is the lead'"'"'s act on main' ]] ||
  fail "rise against the base: $(cat out.txt)"
printf '%s\n' '# header' 'api_aborts prod 5 crates/adtb/src/api/base.rs' 'crash_allows prod 3 crates/aa/src/lib.rs' 'disallowed_methods prod 1 crates/adtb/src/exec/b.rs' >work/tools/structure-allowlist
if "$checker" --against @- "$scratch" >out.txt 2>&1; then
  fail "a new line passed against the base"
fi
grep -q 'disallowed_methods prod crates/adtb/src/exec/b.rs allows 1, the allowlist at the base allows 0' out.txt || fail "new line against the base: $(cat out.txt)"

# Against the base, a file's test count may rise by as much as the same row's prod count in that
# file fell; any other rise fails.
jj describe -m second >/dev/null 2>&1
jj new >/dev/null 2>&1
printf '%s\n' '# header' 'disallowed_methods test 1 crates/adtb/src/exec/b.rs' >work/tools/structure-allowlist
"$checker" --against @- "$scratch" >out.txt 2>&1 || fail "a move to test against the base refused: $(cat out.txt)"
[[ ! -s out.txt ]] || fail "a move to test printed: $(cat out.txt)"
printf '%s\n' '# header' 'disallowed_methods test 2 crates/adtb/src/exec/b.rs' >work/tools/structure-allowlist
if "$checker" --against @- "$scratch" >out.txt 2>&1; then
  fail "a test rise passed against the base"
fi
[[ $(cat out.txt) == 'structure-check: disallowed_methods test crates/adtb/src/exec/b.rs allows 2, the allowlist at the base allows 1: a rise is the lead'"'"'s act on main' ]] ||
  fail "test rise against the base: $(cat out.txt)"
printf '%s\n' '# header' 'disallowed_methods prod 1 crates/adtb/src/exec/b.rs' 'disallowed_methods test 1 crates/adtb/src/exec/b.rs' >work/tools/structure-allowlist
if "$checker" --against @- "$scratch" >out.txt 2>&1; then
  fail "a copied site passed against the base"
fi
[[ $(cat out.txt) == 'structure-check: disallowed_methods test crates/adtb/src/exec/b.rs allows 1, the allowlist at the base allows 0: a rise is the lead'"'"'s act on main' ]] ||
  fail "copied site against the base: $(cat out.txt)"

# clippy rejects a disallowed function imported by name, and the expect that allows it is counted.
mkdir -p demo/src
printf '[package]\nname = "demo"\nversion = "0.1.0"\nedition = "2024"\n[workspace]\n' >demo/Cargo.toml
printf 'disallowed-methods = [{ path = "demo::storage::owner", reason = "use the pager" }]\n' >demo/clippy.toml
printf 'pub mod storage {\n    pub fn owner(page: u32) -> u32 {\n        page\n    }\n}\npub mod user {\n    use crate::storage::owner;\n    pub fn f() -> u32 {\n        owner(1)\n    }\n}\n' >demo/src/lib.rs
clippy() { (cd demo && CARGO_TARGET_DIR=$scratch/demo-target cargo clippy --offline --quiet -- -D warnings 2>&1); }
if out=$(clippy); then
  fail "clippy accepted an imported disallowed function"
fi
[[ $out == *'use of a disallowed method `demo::storage::owner`'* ]] || fail "clippy refused for another reason: $out"
sed -i 's|^    pub fn f|    #[expect(clippy::disallowed_methods, reason = "r")]\n    pub fn f|' demo/src/lib.rs
clippy || fail "the expect did not allow the imported function"
mkdir -p crates/demo && cp demo/src/lib.rs crates/demo/lib.rs
"$checker" --counts "$scratch" | grep -qx 'disallowed_methods prod 1 crates/demo/lib.rs' || fail "the expect was not counted"

# The checked in clippy.toml rejects each owned item by path.
for item in adtb::storage::page::owner adtb_sys::pages::Exclusive::write \
  adtb_sys::pages::PageMemory::lock_exclusive adtb_sys::pages::PageMemory::try_lock_exclusive \
  adtb_sys::pages::Optimistic::upgrade; do
  grep -qF "path = \"$item\"" "$clippy_toml" || fail "clippy.toml does not disallow $item"
done
printf 'structure-check cases passed\n'
