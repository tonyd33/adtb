#!/usr/bin/env bash
# slot NAME BRIEF [N]   give track NAME, briefed in BRIEF, a workspace in a slot directory beside
#                       the main checkout: reuse a free slot, or add `MAIN-slot-M` when none is
#                       usable; print the directory last
#
# First refuses BRIEF unless, outside fenced blocks, it has one `Ticket: STEM` line naming a
# ticket of the main checkout, and the class table defect-classes.md has class rows whose
# mechanism tickets are all tickets. A bug ticket needs a tag `class-none` or class tags of the
# table. When a class has three or more instances (its tickets not wontfix and not its mechanism
# tickets) and one of its mechanism tickets is open or in progress, only a mechanism ticket or a
# brief with a `Site fix because: REASON` line passes.
#
# `land` frees a slot; its directory stays, so target/ stays valid for the next track. Refuses a
# slot whose working copy has changes or a description, with commits not on main, holding files jj
# does not track outside build output, or in use by a process. With N, refuses when slot-N is
# unusable; without, skips such a slot and says why. Empties debug and tmp of the build directories
# of a reused slot when, in one of them, together they are above ADTB_SLOT_CAP_GB (default 20). One
# call runs at a time.
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
name=${1:?usage: slot NAME BRIEF [N]}
brief=${2:?usage: slot NAME BRIEF [N]}
only=${3:-}

# shellcheck source=work/tools/common.bash
source "$root/work/tools/common.bash"

die() {
  printf 'slot: %s\n' "$1" >&2
  exit 1
}

list() {
  jj -R "$root" workspace list --ignore-working-copy -T 'name ++ "\t" ++ root ++ "\n"'
}

# Print the files under $1 that jj does not track, past regenerated build output.
leftovers() {
  (
    cd "$1"
    LC_ALL=C comm -23 \
      <(find . \( -path ./.jj -o -path ./.git -o -path ./target -o -path ./apps/campaign/target -o -name '.devenv*' \
        -o -name .direnv -o -name .pre-commit-config.yaml -o -name .nvim.lua -o -name 'result*' \) \
        -prune -o \( -type f -o -type l \) -printf '%P\n' | LC_ALL=C sort) \
      <(jj file list -T 'path ++ "\n"' | LC_ALL=C sort)
  )
}

# Print why the free slot named $1 at $2 cannot be reused; print nothing when it can.
unusable() {
  local state unlanded files users
  state=$(jj -R "$2" log -r @ --no-graph -T 'if(empty && description == "", "clean", "changed")' 2>&1) ||
    state="unreadable: $state"
  if [[ $state != clean ]]; then
    echo "working copy $state"
    return
  fi
  unlanded=$(jj -R "$2" log -r '::@ ~ ::main ~ @' --no-graph -T 'change_id.short() ++ " "')
  [[ -z $unlanded ]] || echo "commits not on main: $unlanded"
  files=$(leftovers "$2")
  [[ -z $files ]] || echo "untracked files: $(echo "$files" | head -5 | paste -sd' ')"
  users=$(pids_using "$2")
  [[ -z $users ]] || echo "in use by: $(echo "$users" | paste -sd,)"
}

main=$(list | awk -F'\t' '$1 == "default" { print $2 }')
[[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "$name is not a workspace name"
[[ ! $name =~ ^slot-[0-9]+$ && $name != default && $name != main ]] || die "$name is reserved"

issues() {
  tix -C "$main/work/issues" list --status all "$@"
}

# Print the line of ticket $1 in the `tix list` output on stdin.
row() {
  awk -v stem="$1" '$3 == stem'
}

table=$main/.agents/skills/lead/defect-classes.md

# Print the tag and the comma-separated mechanism tickets of each class row of $table, a tab between.
class_rows() {
  awk -F'|' '$3 ~ /^ *`class-[a-z0-9-]+` *$/ {
    gsub(/[ `]/, "", $3); gsub(/ /, "", $(NF - 1)); print $3 "\t" $(NF - 1) }' "$table"
}

gate() {
  local text ticket listed rows found none tag mechs stem live count classed=
  [[ -f $brief ]] || die "no brief $brief"
  text=$(awk '/^[[:space:]]*(```|~~~)/ { fenced = !fenced; next } !fenced' "$brief")
  [[ $(grep -c '^Ticket:' <<<"$text") -le 1 ]] || die "$brief has more than one 'Ticket:' line"
  ticket=$(sed -n 's/^Ticket: *\([A-Za-z0-9._-]\+\) *$/\1/p' <<<"$text")
  [[ -n $ticket ]] || die "$brief names no ticket in a 'Ticket: STEM' line"
  listed=$(issues) || die "tix cannot list $main/work/issues"
  [[ -n $(row "$ticket" <<<"$listed") ]] || die "no ticket $ticket"
  [[ -f $table ]] || die "no class table $table"
  rows=$(class_rows)
  [[ -n $rows ]] || die "$table has no class rows"
  while IFS=$'\t' read -r tag mechs; do
    [[ -n $mechs ]] || die "the Mechanism ticket cell of $tag in $table is empty"
    for stem in ${mechs//,/ }; do
      [[ -n $(row "$stem" <<<"$listed") ]] ||
        die "the Mechanism ticket cell of $tag in $table names $stem, which is not a ticket"
    done
  done <<<"$rows"
  found=$(issues --kind bug | row "$ticket")
  [[ -n $found ]] || return 0
  none=$(issues --tag class-none | row "$ticket")
  while IFS=$'\t' read -r tag mechs; do
    found=$(issues --tag "$tag" | row "$ticket")
    [[ -n $found ]] || continue
    [[ -z $none ]] || die "$ticket carries both class-none and $tag"
    classed=1
    count=$(issues --tag "$tag" | awk -v m=",$mechs," '$2 != "wontfix" && !index(m, "," $3 ",")' | wc -l)
    live=$(awk -v m=",$mechs," 'index(m, "," $3 ",") && ($2 == "open" || $2 == "in-progress") { print $3 }' <<<"$listed" | paste -sd' ')
    ((count >= 3)) && [[ -n $live && ,$mechs, != *",$ticket,"* ]] || continue
    grep -Eq '^Site fix because: *[^[:space:]]' <<<"$text" ||
      die "$ticket is in $tag, which has $count instances while its mechanism tickets $live are open or in progress: brief one of them, or give the brief a 'Site fix because: REASON' line"
  done <<<"$rows"
  [[ -n $classed || -n $none ]] || die "bug ticket $ticket carries no class tag: tag it class-none or a class listed in $table"
}
gate

exec 7>>"$main/.jj/slot.lock"
flock 7

if list | cut -f1 | grep -qxF "$name"; then
  die "workspace $name exists"
fi

reuse() {
  local slot=$1 path=$2
  if over_slot_cap "$path/target" || over_slot_cap "$path/apps/campaign/target"; then
    echo "a build directory of $path is above the cap"
    ADTB_GC_IDLE_HOURS=0 "$root/work/tools/workspace-gc" --clear-build "$slot"
  fi
  jj -R "$path" new main
  jj -R "$path" workspace rename "$name"
  echo "$path"
}

while IFS=$'\t' read -r slot path; do
  free_slot "$slot" "$path" "$main" || continue
  [[ -z $only || $slot == "slot-$only" ]] || continue
  why=$(unusable "$slot" "$path")
  if [[ -z $why ]]; then
    reuse "$slot" "$path"
    exit 0
  fi
  printf 'slot: %s refused: %s\n' "$slot" "$why" >&2
  [[ -z $only ]] || exit 1
done < <(list | sort -t- -k2n)
[[ -z $only ]] || die "no free slot-$only"

n=1
while [[ -e $main-slot-$n ]]; do
  n=$((n + 1))
done
jj -R "$main" workspace add --name "$name" -r main "$main-slot-$n"
echo "$main-slot-$n"
