#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'HELP'
tree-sitter-check   check the editor grammar in tools/tree-sitter-adtb, run from the workspace root

Runs `tree-sitter generate` into target/tree-sitter/generated and compares it with the grammar's
src/, runs `tree-sitter test` for its corpus and highlight tests, then the tests of
adtb-tree-sitter, which compare it with adtb-lang. Needs `tree-sitter` on PATH.
HELP
}

case ${1:-} in
  -h | --help)
    usage
    exit 0
    ;;
esac

grammar=tools/tree-sitter-adtb
if [[ ! -f $grammar/grammar.js ]]; then
  echo "tree-sitter-check: no $grammar/grammar.js: run from the workspace root" >&2
  exit 1
fi
scratch=$(realpath -m "${CARGO_TARGET_DIR:-target}/tree-sitter")
export TREE_SITTER_LIBDIR=$scratch/lib

rm -rf "$scratch/generated"
mkdir -p "$TREE_SITTER_LIBDIR"
env -C "$grammar" tree-sitter generate --js-runtime native -o "$scratch/generated"
diff -rq --exclude=scanner.c "$scratch/generated" "$grammar/src" || {
  echo "tree-sitter-check: $grammar/src differs from what grammar.js generates" >&2
  exit 1
}
tree-sitter test -p "$grammar"
cargo nextest run -p adtb-tree-sitter
