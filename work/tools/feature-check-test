#!/usr/bin/env bash
set -euo pipefail

checker=${1:-$(cd "$(dirname "$0")" && pwd)/feature-check}
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
cd "$scratch"

fail() {
  printf 'feature-check-test: %s\n' "$1" >&2
  exit 1
}

# Write package $1 of directory $2 with the manifest tail $3.
package() {
  mkdir -p "$2/src"
  : >"$2/src/lib.rs"
  printf '[package]\nname = "%s"\nversion = "0.1.0"\nedition = "2024"\n\n%s\n' "$1" "$3" >"$2/Cargo.toml"
}

# Write the root workspace with user's manifest tail $1.
world() {
  rm -rf crates apps
  printf '[workspace]\nmembers = ["crates/*"]\nresolver = "3"\n\n[workspace.dependencies]\nadtb = { path = "crates/adtb" }\n' >Cargo.toml
  package adtb crates/adtb $'[features]\ntesting = []'
  package user crates/user "$1"
}

passes() {
  "$checker" "$scratch" >out.txt 2>&1 || fail "expected a pass for $1, got: $(cat out.txt)"
  [[ ! -s out.txt ]] || fail "a pass for $1 printed: $(cat out.txt)"
}

# Require the checker to fail with the whole output $2, for the case $1.
refuses() {
  if "$checker" "$scratch" >out.txt 2>&1; then
    fail "expected a refusal for $1, got a pass"
  fi
  [[ $(cat out.txt) == "$2" ]] || fail "$1: expected '$2', got: $(cat out.txt)"
}

world $'[dev-dependencies]\nadtb = { workspace = true, features = ["testing"] }'
passes "a dev-dependency with the feature"

world $'[dependencies]\nadtb = { workspace = true }'
passes "a normal dependency without the feature"

world $'[dependencies]\nadtb = { workspace = true, features = ["testing"] }'
refuses "a normal dependency" \
  "feature-check: crates/user/Cargo.toml: a normal dependency on adtb enables testing"

world $'[build-dependencies]\nadtb = { path = "../adtb", features = ["testing"] }'
refuses "a build dependency" \
  "feature-check: crates/user/Cargo.toml: a build dependency on adtb enables testing"

world $'[dependencies]\nadtb = { workspace = true, optional = true }\n\n[features]\nprobe = ["adtb?/testing"]'
refuses "a feature of its own" \
  "feature-check: crates/user/Cargo.toml: feature probe enables adtb/testing"

world $'[dependencies]\nadtb = { workspace = true }'
mkdir -p apps/app
printf '[workspace]\n\n' >apps/app/Cargo.toml
package app apps/app.tmp $'[dependencies]\nadtb = { path = "../../crates/adtb", features = ["testing"] }'
cat apps/app.tmp/Cargo.toml >>apps/app/Cargo.toml
mv apps/app.tmp/src apps/app/src
rm -r apps/app.tmp
refuses "a package of a workspace under apps" \
  "feature-check: apps/app/Cargo.toml: a normal dependency on adtb enables testing"

world ''
package adtb crates/adtb $'[features]\ndefault = ["testing"]\ntesting = []'
refuses "the default features of adtb" \
  "feature-check: crates/adtb/Cargo.toml: the default features include testing"

rm -rf crates/adtb
refuses "a workspace without adtb" "feature-check: no package adtb under $scratch"
