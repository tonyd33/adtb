#!/usr/bin/env bash
# structure-check [DIR]   fail when, in the repository at DIR (default this one), a counted
#                         structure pattern occurs in a file more often than work/tools/structure-allowlist
#                         allows, or the allowlist allows more than occurs. Counts only fall: lower the
#                         allowlist line when a restructure removes sites, and delete it at 0.
# structure-check --against REV [DIR]   fail when the allowlist holds a count above the one the
#                         allowlist at revision REV holds (none counts as 0); passes when REV has no allowlist
#                         except that a file's test count may rise by as much as the same row's prod count in
#                         that file fell
# structure-check --counts [DIR]   print the allowlist lines for the counts found
#
# The rows, their rules and the allowlist format are in the header of structure-allowlist. This
# tool owns the patterns; no other tool counts them. The disallowed_methods row comes from the
# adtb-structure binary, which parses the sources; the other rows are text matches.
set -euo pipefail

mode=check
against=
case ${1:-} in
  --counts)
    mode=counts
    shift
    ;;
  --against)
    mode=against
    against=${2:?usage: structure-check --against REV [DIR]}
    shift 2
    ;;
esac
tools_root=$(cd "$(dirname "$0")/../.." && pwd)
cd "${1:-$tools_root}"
allowlist=work/tools/structure-allowlist

roots=()
[[ ! -d crates ]] || roots+=(crates)

# Print `ROW PATH COUNT` for each file under the roots with matches of pattern $2, outside the globs $3...
count() {
  local row=$1 pattern=$2 glob out
  local -a args=(--no-ignore --count-matches --no-heading -g '*.rs' -g '!**/target/**')
  shift 2
  for glob in "$@"; do
    args+=(-g "!$glob")
  done
  ((${#roots[@]})) || return 0
  out=$(rg "${args[@]}" -- "$pattern" "${roots[@]}" || [[ $? == 1 ]])
  awk -F: -v row="$row" 'NF { print row, $1, $2 }' <<<"$out"
}

# Print `ROW PATH COUNT` for each file under directory $2 with matches of pattern $3, passing rg
# the flags $4...
count_under() {
  local row=$1 dir=$2 pattern=$3 out
  shift 3
  [[ -d $dir ]] || return 0
  out=$(rg --no-ignore --count-matches --no-heading -g '*.rs' "$@" -- "$pattern" "$dir" || [[ $? == 1 ]])
  awk -F: -v row="$row" 'NF { print row, $1, $2 }' <<<"$out"
}

# Print `ROW PATH COUNT` of the disallowed_methods row for every file, `disallowed_methods_test`
# for an expect under cfg(test).
disallowed() {
  ((${#roots[@]})) || return 0
  cargo run --quiet --locked --offline --manifest-path "$tools_root/Cargo.toml" -p adtb-structure -- "${roots[@]}"
}

# Print the lines `ROW KIND COUNT FILE`, test files apart from production ones.
found_counts() {
  {
    disallowed
    count crash_loops '\bfn \w*crash_loop\w*\b'
    count_under database_marks crates '(?<!is_quarantined\(|is_quarantined\(storage::|quarantined_name\(|&\[object, |for object in std::iter::once\(|quarantined_as\(&BTreeSet::from\(\[|1 => Some\()(storage::)?Quarantine::Database(?! =>)|\bMark::(Database|Held)\b' -P -g '!**/target/**' -g '!tests.rs' -g '!*_tests.rs' -g '!**/tests/**' -g '!**/test_world/**' -g '!**/storage/policy.rs'
    count_under mark_setters crates '\.quarantine\(|\bmarks\(\)\s*\.(hold|change)\(' -P -U -g '!**/target/**' -g '!tests.rs' -g '!*_tests.rs' -g '!**/tests/**' -g '!**/test_world/**'
    count_under marked_readers crates '(?<!fn )\badmit_database\(|\bstd::iter::once\(\s*((crate::)?storage::)?Quarantine::Database\s*\)|\bis_quarantined\(\s*((crate::)?storage::)?Quarantine::Database\s*,?\s*\)' -P -U -g '!**/target/**' -g '!tests.rs' -g '!*_tests.rs' -g '!**/tests/**' -g '!**/test_world/**' -g '!**/storage/**' -g '!**/mvcc/**'
    count_under index_marks crates '(?<!is_quarantined\(|== |contains\(&|marked\(|matches!\(m, |\(id, _\)\| |release = Some\(|Ok\()(storage::)?Quarantine::Index\b|\bQuarantine::(\*|\{[^}]*\bIndex\b)' -P -g '!**/target/**' -g '!tests.rs' -g '!*_tests.rs' -g '!**/tests/**' -g '!**/test_world/**' -g '!**/storage/policy.rs' -g '!**/storage/quarantine.rs'
    count_under api_aborts crates/adtb/src/api '\.abort\(' -g '!tests.rs' -g '!*_tests.rs' -g '!**/tests/**'
    count crash_allows '\bfn allows\b'
  } | awk '
    { test = ($1 == "disallowed_methods_test"); if (test) $1 = "disallowed_methods"
      kind = (test || $2 ~ /(^|\/)tests\// || $2 ~ /(^|\/)tests\.rs$/ || $2 ~ /_tests\.rs$/ || $2 ~ /\/test_world\//) ? "test" : "prod"
      key = $1 " " kind " " $2
      if (!(key in sum)) order[++n] = key
      sum[key] += $3 }
    END { for (i = 1; i <= n; i++) { split(order[i], f, " "); print f[1], f[2], sum[order[i]], f[3] } }'
}

if [[ $mode == counts ]]; then
  found=$(found_counts)
  LC_ALL=C sort -k1,1 -k4 <<<"$found"
  exit 0
fi

[[ -f $allowlist ]] || { echo "structure-check: no $allowlist" >&2; exit 1; }

if [[ $mode == against ]]; then
  old=$(jj --ignore-working-copy --color=never file show -r "$against" "$allowlist" 2>/dev/null) || exit 0
  awk -v old="$old" '
    function note(msg) { print "structure-check: " msg; bad = 1 }
    BEGIN {
      n = split(old, lines, "\n")
      for (i = 1; i <= n; i++) {
        if (lines[i] ~ /^[[:space:]]*(#|$)/) continue
        split(lines[i], f, " ")
        was[f[1] " " f[2] " " f[4]] = f[3]
      }
    }
    /^[[:space:]]*(#|$)/ { next }
    { row[++m] = $1; kind[m] = $2; num[m] = $3; file[m] = $4; now[$1 " " $2 " " $4] = $3 }
    END {
      for (i = 1; i <= m; i++) {
        key = row[i] " " kind[i] " " file[i]
        before = (key in was) ? was[key] : 0
        if (kind[i] == "test") {
          pkey = row[i] " prod " file[i]
          moved = ((pkey in was) ? was[pkey] : 0) - ((pkey in now) ? now[pkey] : 0)
          if (moved > 0) before += moved
        }
        if (num[i] > before)
          note(key " allows " num[i] ", the allowlist at the base allows " before ": a rise is the lead'"'"'s act on main")
      }
      exit bad
    }' "$allowlist" | LC_ALL=C sort
  exit 0
fi

found=$(found_counts)

awk -v list="$allowlist" '
  function note(msg) { print "structure-check: " msg; bad = 1 }
  BEGIN {
    split("disallowed_methods database_marks mark_setters index_marks marked_readers api_aborts crash_loops crash_allows", names, " ")
    for (i in names) row[names[i]] = 1
    while ((getline line < list) > 0) {
      if (line ~ /^[[:space:]]*(#|$)/) continue
      n = split(line, f, " ")
      key = f[1] " " f[2] " " f[4]
      if (n != 4 || !(f[1] in row) || f[2] !~ /^(prod|test)$/ || f[3] !~ /^[0-9]+$/ || f[3] == 0)
        note(list ": bad line: " line)
      else if (key in allowed) note(list ": " key " listed twice")
      else allowed[key] = f[3]
    }
  }
  { key = $1 " " $2 " " $4; actual[key] = $3 }
  END {
    for (key in actual) {
      have = actual[key]; want = (key in allowed) ? allowed[key] : 0
      if (have > want)
        note(key " has " have ", allowed " want ": remove the sites, do not raise the allowlist")
    }
    for (key in allowed) {
      have = (key in actual) ? actual[key] : 0
      if (have < allowed[key])
        note(key " has " have ", allowed " allowed[key] ": stale, " (have ? "lower the allowlist line to " have : "delete the allowlist line"))
    }
    exit bad
  }' <<<"$found" | LC_ALL=C sort
