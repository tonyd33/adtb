#!/usr/bin/env bash
set -uo pipefail

usage() {
  cat <<'HELP'
suite [ARGS]   run `cargo nextest run --no-fail-fast ARGS` over the workspace in a scope of
               `limited`, unless this already runs in one

The full output goes to target/suite.txt, or ADTB_SUITE_OUT when set, and ends with
`suite: exit N`. Prints only the build errors, the failing, killed and timed out tests, the
summary, the scope's peak memory and that path, and exits with nextest's status.
HELP
}

case ${1:-} in
  -h | --help)
    usage
    exit 0
    ;;
esac

tools=$(dirname "$(realpath "$0")")
cgroup=$(</proc/self/cgroup)
cgroup=${cgroup#0::}
[[ $cgroup == */adtb-run-*.scope || -n ${ADTB_UNLIMITED:-} ]] || exec "$tools/limited" "$0" "$@"

root=$(realpath "$tools/../..")
out=${ADTB_SUITE_OUT:-${CARGO_TARGET_DIR:-$root/target}/suite.txt}
mkdir -p "$(dirname "$out")"
ulimit -Sc 0
cargo nextest run --manifest-path "$root/Cargo.toml" --no-fail-fast "$@" >"$out" 2>&1
status=$?
echo "suite: exit $status" >>"$out"
grep -E '^error|^\s+(FAIL|SIGABRT|SIGSEGV|SIGKILL|TIMEOUT)|Summary' "$out" | sort -u
peak=/sys/fs/cgroup$cgroup/memory.peak
if [[ $cgroup == */adtb-run-*.scope && -r $peak ]]; then
  echo "peak $(($(<"$peak") >> 20)) MiB in ${cgroup##*/}"
fi
echo "output in $out"
exit "$status"
