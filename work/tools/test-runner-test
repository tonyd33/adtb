#!/usr/bin/env bash
# test-runner-test   prove a runaway under test-runner is killed at its cap, a command's exit status
#                    comes through, and a terminated runner stops its command.
set -u
runner=$(cd "$(dirname "$0")" && pwd)/test-runner

ADTB_TEST_MEM_EACH_KB=200000 "$runner" tail /dev/zero
[[ $? -eq 137 ]] || { echo "the runaway was not killed"; exit 1; }
"$runner" sh -c 'exit 7'
rc=$?
[[ $rc -eq 7 ]] || { echo "exit status lost: $rc"; exit 1; }
"$runner" sleep 30 &
pid=$!
sleep 0.3
kill -TERM "$pid"
wait "$pid"
pgrep -P "$pid" >/dev/null && { echo "the command outlived its runner"; exit 1; }
echo "test-runner: a runaway died alone"
