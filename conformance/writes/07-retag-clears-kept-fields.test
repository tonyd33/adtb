# A retag action sets to None only the clear fields the new constructor keeps, the header's: a clear field of the old constructor goes with it, even where the new constructor has a field of its name.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  type W = { id: Key ws, owner: Key users on delete cascade }
  relation ws : W key id generate sequence
  type Thing { id: Key things, h: Option (Key ws) on delete clear }
    = C { u: Key users on delete retag D { n: 5 }, n: Option (Key ws) on delete clear }
    | D { n: I64 }
  relation things : Thing key id generate sequence
run
  insert users { id: users.key(1), name: "a" }
  insert ws { id: ws.key(1), owner: users.key(1) }
  insert things.C { id: things.key(1), h: Some { value: ws.key(1) }, u: users.key(1), n: Some { value: ws.key(1) } }
run
  delete x in users where key x == users.key(1)
query rowsort
  from x in things select x
----
D { id: things.key(1), h: None, n: 5 }
query rowsort
  from x in ws select x
----
