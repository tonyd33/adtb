# An insert takes one record into a constructor relation or a one-constructor relation, or a query's rows into either or into a sum.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  type Identity { id: Key identities, user: Key users }
    = EmailPass { email: Text, hash: Text }
    | Google    { gid: Text }
    | Apple     { sub: Text }
  relation identities : Identity key id generate sequence
  type Import { id: Key imports } = Email { user: Key users, addr: Text, h: Text }
                                  | Oauth { user: Key users, sub: Text }
  relation imports : Import key id generate sequence
run
  insert users { id: users.key(1), name: "a" }
  insert users from ([{ id: users.key(2), name: "b" }, { id: users.key(3), name: "c" }])
  insert identities.Google { id: identities.key(1), user: users.key(1), gid: "g1" }
  insert imports.Oauth { id: imports.key(1), user: users.key(2), sub: "s2" }
  insert imports.Email { id: imports.key(2), user: users.key(3), addr: "c@x", h: "h3" }
query
  from u in users select u
----
User { id: users.key(1), name: "a" }
User { id: users.key(2), name: "b" }
User { id: users.key(3), name: "c" }
run
  insert identities.Google from (
    from x in imports.Oauth select { id: identities.key(10 + value(key x)), user: x.user, gid: x.sub })
query
  from g in identities.Google select g
----
Google { id: identities.key(1), user: users.key(1), gid: "g1" }
Google { id: identities.key(11), user: users.key(2), gid: "s2" }
run
  insert identities from (
    from x in imports
    select match x
      | Email e -> EmailPass { id: identities.key(20 + value(key e)), user: e.user, email: e.addr, hash: e.h }
      | Oauth o -> Apple { id: identities.key(20 + value(key o)), user: o.user, sub: o.sub })
query
  from i in identities select i
----
EmailPass { id: identities.key(22), user: users.key(3), email: "c@x", hash: "h3" }
Google { id: identities.key(1), user: users.key(1), gid: "g1" }
Google { id: identities.key(11), user: users.key(2), gid: "s2" }
Apple { id: identities.key(21), user: users.key(2), sub: "s2" }
run
  insert users from (from u in users where u.name == "a" select User { id: users.key(4), name: "d" })
query
  from u in users where key u == users.key(4) select u.name
----
"d"
