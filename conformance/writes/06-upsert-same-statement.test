# An upsert does not see rows another write of its statement inserts: a conflict only with such a row, or between two of its own rows, fails the statement.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  type Identity { id: Key identities, user: Key users }
    = Google { gid: Text }
  relation identities : Identity key id generate sequence
    unique (gid) in Google
run
  insert users from (from k in [1, 2] select { id: users.key(k), name: "u" ++ print(k) })
error Violated
  (insert identities.Google { id: identities.key(1), user: users.key(1), gid: "z" },
   insert identities.Google { id: identities.key(2), user: users.key(2), gid: "z" }
   unless conflict on (gid) in Google
   else update old set old)
error KeyViolation
  (insert users { id: users.key(9), name: "a" },
   insert users { id: users.key(9), name: "b" }
   unless conflict on key
   else update old set old)
error Violated
  insert identities.Google from (
    from p in [1, 2] select { id: identities.key(p), user: users.key(p), gid: "dup" })
  unless conflict on (gid) in Google
  else update old set old
error KeyViolation
  insert users from (from p in ["x", "y"] select { id: users.key(7), name: p })
  unless conflict on key
  else update old set old
query
  count(i for i in identities)
----
0
query
  from u in users select key u
----
users.key(1)
users.key(2)
