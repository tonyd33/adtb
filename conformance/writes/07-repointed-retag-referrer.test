# A referrer that the statement repoints away from a deleted row keeps its constructor; on delete retag reaches only referrers left pointing at it.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  type Identity = { id: Key identities, user: Key users, gid: Text }
  relation identities : Identity key id generate sequence
  type Login { id: Key logins, user: Key users }
    = Active  { identity: Key identities on delete retag Revoked {} }
    | Revoked { reason: Text }
  relation logins : Login key id generate sequence default Revoked.reason = "gone"
run
  insert users { id: users.key(1), name: "a" }
  insert identities from ([{ id: identities.key(1), user: users.key(1), gid: "g1" },
                           { id: identities.key(2), user: users.key(1), gid: "g2" }])
  insert logins.Active { id: logins.key(1), user: users.key(1), identity: identities.key(1) }
  insert logins.Active { id: logins.key(2), user: users.key(1), identity: identities.key(1) }
query rowsort
  from x in users select x
----
User { id: users.key(1), name: "a" }
query rowsort
  from x in identities select x
----
Identity { id: identities.key(1), user: users.key(1), gid: "g1" }
Identity { id: identities.key(2), user: users.key(1), gid: "g2" }
query rowsort
  from x in logins select x
----
Active { id: logins.key(1), user: users.key(1), identity: identities.key(1) }
Active { id: logins.key(2), user: users.key(1), identity: identities.key(1) }
run
  transact
    update s in logins.Active where key s == logins.key(1) set Active { s with identity: identities.key(2) }
    delete i in identities where key i == identities.key(1)
query rowsort
  from x in users select x
----
User { id: users.key(1), name: "a" }
query rowsort
  from x in identities select x
----
Identity { id: identities.key(2), user: users.key(1), gid: "g2" }
query rowsort
  from x in logins select x
----
Active { id: logins.key(1), user: users.key(1), identity: identities.key(2) }
Revoked { id: logins.key(2), user: users.key(1), reason: "gone" }
query
  from s in logins select s
----
Active { id: logins.key(1), user: users.key(1), identity: identities.key(2) }
Revoked { id: logins.key(2), user: users.key(1), reason: "gone" }
