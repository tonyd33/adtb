# An upsert on the key binds old at the sum's row type, which a match over every constructor consumes; fail in its branch rejects the statement.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  type Identity { id: Key identities, user: Key users }
    = EmailPass { email: Text, hash: Text }
    | Google    { gid: Text }
    | Apple     { sub: Text }
  relation identities : Identity key id generate sequence
run
  insert users { id: users.key(1), name: "a" }
  insert identities from ([EmailPass { id: identities.key(1), user: users.key(1), email: "e", hash: "h" },
                           Google { id: identities.key(2), user: users.key(1), gid: "g" }])
run
  insert identities.Google { id: identities.key(2), user: users.key(1), gid: "g-new" }
  unless conflict on key
  else match old
    | Google o    -> update o set Google { o with gid: "g-new" }
    | EmailPass e -> fail "identity is email"
    | Apple a     -> fail "identity is apple"
query
  from g in identities.Google select g
----
Google { id: identities.key(2), user: users.key(1), gid: "g-new" }
error UserError
  insert identities.Google { id: identities.key(1), user: users.key(1), gid: "g-x" }
  unless conflict on key
  else match old
    | Google o    -> update o set Google { o with gid: "g-x" }
    | EmailPass e -> fail "identity is email"
    | Apple a     -> fail "identity is apple"
query
  from i in identities select i
----
EmailPass { id: identities.key(1), user: users.key(1), email: "e", hash: "h" }
Google { id: identities.key(2), user: users.key(1), gid: "g-new" }
run
  insert identities.Google { id: identities.key(3), user: users.key(1), gid: "g3" }
  unless conflict on key
  else match old
    | Google o    -> update o set Google { o with gid: "never" }
    | EmailPass e -> fail "identity is email"
    | Apple a     -> fail "identity is apple"
query
  from g in identities.Google select g
----
Google { id: identities.key(2), user: users.key(1), gid: "g-new" }
Google { id: identities.key(3), user: users.key(1), gid: "g3" }
run
  insert identities.Google { id: identities.key(1), user: users.key(1), gid: "from-email" }
  unless conflict on key
  else match old
    | Google o    -> update o set o
    | EmailPass e -> update e set Google { gid: new.gid }
    | Apple a     -> update a set a
query
  from i in identities select i
----
Google { id: identities.key(1), user: users.key(1), gid: "from-email" }
Google { id: identities.key(2), user: users.key(1), gid: "g-new" }
Google { id: identities.key(3), user: users.key(1), gid: "g3" }
error Invalid
  insert identities.Google { id: identities.key(2), user: users.key(1), gid: "x" }
  unless conflict on key
  else match old
    | Google o -> update o set o
