# An insert must give every field it does not default, no field the constructor lacks, and constructor values when the target has several constructors.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  type Identity { id: Key identities, user: Key users }
    = EmailPass { email: Text, hash: Text }
    | Google    { gid: Text }
    | Apple     { sub: Text }
  relation identities : Identity key id generate sequence
  set OAuth of identities = Google | Apple
run
  insert users { id: users.key(1), name: "a" }
error Invalid
  insert users { id: users.key(2) }
error Invalid
  insert users { id: users.key(2), name: "b", age: 3 }
error Invalid
  insert identities.Google { user: users.key(1) }
error Invalid
  insert identities.Google { user: users.key(1), gid: "g", sub: "s" }
error Invalid
  insert identities { user: users.key(1), gid: "g" }
error Invalid
  insert identities from ([{ user: users.key(1), gid: "g" }])
error Invalid
  insert identities.(Google | Apple) from ([EmailPass { user: users.key(1), email: "e", hash: "h" }])
error Invalid
  insert identities.OAuth from ([EmailPass { user: users.key(1), email: "e", hash: "h" }])
error Invalid
  insert identities.Google from ([Apple { user: users.key(1), sub: "s" }])
error Invalid
  insert users { id: users.key(2), name: 3 }
error Invalid
  insert users { id: 2, name: "b" }
query
  from i in identities select i
----

run
  insert identities.(Google | Apple) from ([Google { id: identities.key(1), user: users.key(1), gid: "g" },
                                            Apple { id: identities.key(2), user: users.key(1), sub: "s" }])
  insert identities.OAuth from ([Apple { id: identities.key(3), user: users.key(1), sub: "t" }])
query
  from i in identities select i
----
Google { id: identities.key(1), user: users.key(1), gid: "g" }
Apple { id: identities.key(2), user: users.key(1), sub: "s" }
Apple { id: identities.key(3), user: users.key(1), sub: "t" }
