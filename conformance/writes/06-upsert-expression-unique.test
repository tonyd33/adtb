# An upsert on a unique over expressions conflicts when the expressions are equal on the two rows.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  type Identity { id: Key identities, user: Key users }
    = EmailPass { email: Text, hash: Text }
    | Google    { gid: Text }
  relation identities : Identity key id generate sequence
    unique (lower(email)) in EmailPass
run
  insert users from (from k in [1, 2] select { id: users.key(k), name: "u" ++ print(k) })
  insert identities.EmailPass { id: identities.key(1), user: users.key(1), email: "Ann@X", hash: "h1" }
run
  insert identities.EmailPass { id: identities.key(2), user: users.key(2), email: "ANN@x", hash: "h2" }
  unless conflict on (lower(email)) in EmailPass
  else update old set EmailPass { old with hash: new.hash }
query
  from e in identities.EmailPass select e
----
EmailPass { id: identities.key(1), user: users.key(1), email: "Ann@X", hash: "h2" }
run
  insert identities.EmailPass { id: identities.key(3), user: users.key(2), email: "bo@x", hash: "h3" }
  unless conflict on (lower(email)) in EmailPass
  else update old set old
query
  from e in identities.EmailPass select key e
----
identities.key(1)
identities.key(3)
error Violated
  insert identities.EmailPass { id: identities.key(4), user: users.key(2), email: "BO@X", hash: "h4" }
