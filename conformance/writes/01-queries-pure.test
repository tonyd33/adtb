# A query never changes the database, and a write is allowed only where a change set is expected.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  type Log = { id: Key logs, n: I64 }
  relation logs : Log key id generate sequence
run
  insert users { id: users.key(1), name: "ann" }
query
  from u in users select u.name
----
"ann"
query
  count(u for u in users)
----
1
