# An insert whose key is held by a pre-state row the statement does not delete is a key violation, even when the rows are equal.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  type Item { id: Key items } = Small { n: I64 } | Large { n: I64 }
  relation items : Item key id generate sequence
run
  insert users { id: users.key(1), name: "a" }
  insert items from ([Small { id: items.key(1), n: 1 }])
error KeyViolation
  insert users { id: users.key(1), name: "a" }
error KeyViolation
  insert users { id: users.key(1), name: "other" }
error KeyViolation
  insert items.Large { id: items.key(1), n: 1 }
error KeyViolation
  insert users from (from u in users select { id: key u, name: u.name })
query
  from u in users select u
----
User { id: users.key(1), name: "a" }
query
  from i in items select i
----
Small { id: items.key(1), n: 1 }
run
  (update u in users set User { u with name: "b" },
   insert users { id: users.key(1), name: "b" })
query
  from u in users select u
----
User { id: users.key(1), name: "b" }
