# A statement may repoint a restrict reference and delete its old target together; a referrer whose new value still names a deleted row is refused.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  type Badge = { id: Key badges, owner: Key users on delete restrict, label: Text }
  relation badges : Badge key id generate sequence
run
  insert users from (from k in [1, 2] select { id: users.key(k), name: "u" ++ print(k) })
  insert badges { id: badges.key(1), owner: users.key(1), label: "b1" }
error Violated
  (update d in badges set Badge { d with label: "renamed" },
   delete x in users where key x == users.key(1))
query
  from b in badges select b
----
Badge { id: badges.key(1), owner: users.key(1), label: "b1" }
run
  (update d in badges set Badge { d with owner: users.key(2) },
   delete x in users where key x == users.key(1))
query
  from b in badges select b
----
Badge { id: badges.key(1), owner: users.key(2), label: "b1" }
query
  from u in users select key u
----
users.key(2)
