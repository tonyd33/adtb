# Text, decimal, pattern, instant and zone primitives over stored rows give the reference's rows,
# at the edges of their ranges and of Unicode case mapping.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  type Order = { id: Key orders, user: Key users, total: I64, qty: I64 }
  relation orders : Order key id generate sequence
run
  insert users from [User { id: users.key(1), name: "ann" }, User { id: users.key(2), name: "bo" }, User { id: users.key(3), name: "cy" }]
  insert orders from [Order { id: orders.key(1), user: users.key(1), total: 100, qty: 2 },
                      Order { id: orders.key(2), user: users.key(1), total: 100, qty: 0 },
                      Order { id: orders.key(3), user: users.key(2), total: 30, qty: 3 },
                      Order { id: orders.key(4), user: users.key(1), total: 50, qty: 5 }]
query
  from u in users select lower(u.name)
----
"ann"
"bo"
"cy"
query
  from u in users select upper(u.name)
----
"ANN"
"BO"
"CY"
query
  from u in users select u.name ++ "́"
----
"anń"
"bó"
"cý"
query
  from o in orders select text(o.total)
----
"100"
"30"
"50"
query
  from o in orders select div(decimal(o.total, 2), decimal(o.qty + 1, 0), 2, HalfEven)
----
7.50
8.33
33.33
100.00
query
  from u in users select grapheme_len(u.name)
----
2
3
query
  from u in users select matches(u.name, "^a")
----
False
True
query
  from u in users select lower("ÀÉΣ" ++ u.name)
----
"àéσann"
"àéσbo"
"àéσcy"
query
  from u in users select lower("İ" ++ u.name)
----
"i̇ann"
"i̇bo"
"i̇cy"
query
  from u in users select upper(u.name ++ "ßŉ")
----
"ANNSSʼN"
"BOSSʼN"
"CYSSʼN"
query
  from u in users select fold(u.name ++ "ẞΣς")
----
"annssσσ"
"bossσσ"
"cyssσσ"
query
  from u in users select fold(upper(u.name)) == fold(u.name)
----
True
query
  from u in users select grapheme_len(u.name ++ "é👍🏽🇨🇦")
----
5
6
query
  from u in users select matches(u.name, "(?i)^A")
----
False
True
query
  from u in users select matches(u.name ++ "\n", "n$")
----
False
query
  from u in users select matches(u.name ++ "\nx", "(?m)n$")
----
False
True
query
  try (from o in orders select match Instant.parse("+294247-01-10T04:00:54.775807Z") | None -> "none" | Some i -> print(i.value + micros(o.qty)))
----
Err { error: ArithmeticOverflow }
query
  try (from o in orders select match Instant.parse("-290308-12-21T19:59:05.224192Z") | None -> "none" | Some i -> text(i.value + micros(o.qty - 2)))
----
Err { error: ArithmeticOverflow }
query
  try (from o in orders select match Instant.parse("+294247-01-10T04:00:54.775807Z") | None -> "none" | Some i -> print(in_zone(i.value - micros(o.qty), "Asia/Kolkata")))
----
Err { error: ArithmeticOverflow }
query
  try (from o in orders select match Instant.parse("-290308-12-21T19:59:05.224192Z") | None -> "none" | Some i -> print(in_zone(i.value, "America/New_York") + micros(o.qty)))
----
Err { error: ArithmeticOverflow }
