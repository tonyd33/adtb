# A newtype's domain is checked where its values are stored, never by construction.
schema
  module test
  type Email = new Text where matches(self, "^[^@]+@[^@]+$")
  type Contact = { id: Key contacts, email: Email }
  relation contacts : Contact key id generate sequence
query
  unwrap(Email("not an email"))
----
"not an email"
query
  Email("x") == Email("x")
----
true
error Violated
  insert contacts { id: contacts.key(1), email: Email("not an email") }
query
  count(c for c in contacts)
----
0
run
  insert contacts { id: contacts.key(2), email: Email("a@b") }
error Violated
  update c in contacts where key c == contacts.key(2) set Contact { c with email: Email("nope") }
query
  from c in contacts select unwrap(c.email)
----
"a@b"
