# Equality between two distinct types is a type error, except numeric equality between Decimal scales.
schema
  module test
  fn i16_of (x: I16) -> I16 = x
  fn i64_of (x: I64) -> I64 = x
  fn f (x: F64) -> F64 = x
  fn d (x: Decimal 1) -> Decimal 1 = x
  type Cents = new I64
  type Point = { x: I64, y: I64 }
  type Pt = { x: I64, y: I64 }
query
  1.0 == 1.000
----
true
error Invalid
  i16_of(1) == i64_of(1)
error Invalid
  i64_of(1) == f(1.0)
error Invalid
  1 == "1"
error Invalid
  d(1.0) == f(1.0)
error Invalid
  Cents(1) == i64_of(1)
error Invalid
  Point { x: 1, y: 2 } == Pt { x: 1, y: 2 }
error Invalid
  1s == 1
error Invalid
  "a" != Cents(1)
error Invalid
  [1] == 1
