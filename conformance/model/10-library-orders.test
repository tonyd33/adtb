# Bool, Option a and Span a are ordered when their arguments are; None sorts first and spans order by start then end.
schema
  module test
  type Status = Draft | Sent
  fn s (a: I64, b: I64) -> Span I64 = span(a, b)
  fn none () -> Option I64 = None
  fn draft () -> Option Status = Some { value: Draft }
  fn some (x: I64) -> Option I64 = Some { value: x }
query
  False < True
----
true
query
  none() < some(0)
----
true
query
  Some { value: 1 } < Some { value: 2 }
----
true
query
  [some(2), none(), some(1)]
----
None
Some { value: 1 }
Some { value: 2 }
error Invalid
  draft() < draft()
query
  s(1, 5) < s(2, 3)
----
true
query
  s(1, 3) < s(1, 5)
----
true
query
  [s(2, 3), s(1, 5), s(1, 3)]
----
span(1, 3)
span(1, 5)
span(2, 3)
