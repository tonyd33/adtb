# Decimal + and - take the larger scale, * the sum of scales, there is no /, comparison is numeric across scales and overflow faults.
schema
  module test
  fn d0 (x: Decimal 0) -> Decimal 0 = x
  fn d38 (x: Decimal 38) -> Decimal 38 = x
query
  1.5 + 1.25
----
2.75
query
  1.0 + 1.00
----
2.00
query
  1.5 - 2.25
----
-0.75
query
  1.5 * 1.25
----
1.875
query
  1.0 * 1.0
----
1.00
query
  1.0 == 1.00
----
true
query
  1.0 < 1.05
----
true
query
  2.50 > 2.5
----
false
error Invalid
  1.0 / 2.0
error Faulted
  d0(99999999999999999999999999999999999999) + 1
query
  1.5 + 1
----
2.5
# Each operand is brought to the larger scale exactly, even where the rescaled operand needs more than 38 digits.
query
  1.5 + 0.025
----
1.525
query
  d0(17500000000000000000000000000000000000) - 9000000000000000000000000000000000000.0
----
8500000000000000000000000000000000000.0
query
  try (d0(90000000000000000000000000000000000000) + d0(90000000000000000000000000000000000000))
----
Err { error: ArithmeticOverflow }
query
  d0(-90000000000000000000000000000000000000) < d38(0.00000000000000000000000000000000000001)
----
true
