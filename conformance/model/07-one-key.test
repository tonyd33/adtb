# One key ranges over every constructor of a relation: no two rows agree on it, whatever their constructors.
schema
  module test
  type Identity { id: Key identities, user: Text }
    = EmailPass { email: Text }
    | Google    { gid: Text }
  relation identities : Identity key id generate sequence
run
  insert identities.EmailPass { id: identities.key(1), user: "ann", email: "a@x" }
error KeyViolation
  insert identities.Google { id: identities.key(1), user: "bo", gid: "g" }
error KeyViolation
  insert identities.EmailPass { id: identities.key(1), user: "ann", email: "a@x" }
error KeyViolation
  transact
    insert identities.Google { id: identities.key(2), user: "bo", gid: "g" }
    insert identities.Google { id: identities.key(2), user: "bo", gid: "h" }
query
  from i in identities select i
----
EmailPass { id: identities.key(1), user: "ann", email: "a@x" }
run
  update i in identities where key i == identities.key(1) set Google { gid: "g" }
query
  from i in identities select key i
----
identities.key(1)
query
  from i in identities select i
----
Google { id: identities.key(1), user: "ann", gid: "g" }
