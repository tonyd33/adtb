# A newtype over an ordered base and Key r over an ordered key value are ordered by the underlying value.
schema
  module test
  type Cents = new I64
  type Country = { code: Text, name: Text }
  relation countries : Country key code
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
run
  insert countries { code: "PT", name: "Portugal" }
  insert countries { code: "DE", name: "Germany" }
  insert countries { code: "FR", name: "France" }
  insert users { id: users.key(10), name: "a" }
  insert users { id: users.key(2), name: "b" }
query
  Cents(-1) < Cents(1)
----
true
query
  from c in countries select key c
----
countries.key("DE")
countries.key("FR")
countries.key("PT")
query
  users.key(2) < users.key(10)
----
true
query
  from u in users select u order by u.id desc
----
User { id: users.key(10), name: "a" }
User { id: users.key(2), name: "b" }
query
  max(key c for c in countries)
----
Some { value: countries.key("PT") }
