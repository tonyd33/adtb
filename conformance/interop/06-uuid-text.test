# UUID formatting covers all in-memory Bytes representations; storage checks the domain.
schema
  module test
  type Token = { id: Key tokens, value: Uuid }
  relation tokens : Token key id generate sequence
query
  Uuid(bytes(""))
----
Uuid(0x)
query
  unwrap(Uuid(bytes("")))
----
0x
query
  text(Uuid(bytes("")))
----
"Uuid(0x)"
query
  print(Uuid(bytes("")))
----
"Uuid(0x)"
query
  Uuid.parse(print(Uuid(bytes("")))) == Some { value: Uuid(bytes("")) }
----
True
