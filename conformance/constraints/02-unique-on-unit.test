# An index or unique element of type `()` is admitted and keys every row alike: a unique over it holds at most one row.
schema
  module test
  type Item = { id: Key items, n: I64 }
  relation items : Item key id generate sequence
    unique (())
  type Note = { id: Key notes, n: I64 }
  relation notes : Note key id generate sequence
    index (())
run
  insert items { id: items.key(1), n: 1 }
error Violated
  insert items { id: items.key(2), n: 2 }
run
  insert notes { id: notes.key(1), n: 1 }
  insert notes { id: notes.key(2), n: 2 }
query
  from i in items select i.n
