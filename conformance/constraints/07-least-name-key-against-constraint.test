# Of the violated constraints the one with the least name is reported: KeyViolation only when that is a key.
schema
  module test
  type User = { id: Key users, name: Text }
  relation users : User key id generate sequence
  constraint aa_names = from u in users where u.name == "aa" select u
  constraint zz_names = from u in users where u.name == "zz" select u
  constraint users_x = from u in users where u.name == "ux" select u
  check name_short on users (scalar_len(name) < 6)
run
  insert users { id: users.key(1), name: "ann" }
# test::aa_names sorts before test::users.key
error Violated
  insert users { id: users.key(1), name: "aa" }
# test::users.key sorts before test::zz_names
error KeyViolation
  insert users { id: users.key(1), name: "zz" }
# test::name_short sorts before test::users.key
error Violated
  insert users { id: users.key(1), name: "toolong" }
# "." sorts before "_" in code-point order, so test::users.key sorts before test::users_x
error KeyViolation
  insert users { id: users.key(1), name: "ux" }
error KeyViolation
  insert users { id: users.key(1), name: "bo" }
query
  from u in users select u.name
----
"ann"
