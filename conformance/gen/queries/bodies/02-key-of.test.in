# key x is defined exactly where the relation of x is statically known.
@SCHEMA@
@RUN@
query rowsort
  from u in users select key u
----
users.key(1)
users.key(2)
users.key(3)
query rowsort
  from g in identities.Google select key g
----
identities.key(2)
identities.key(3)
query rowsort
  from o in identities.OAuth where o.user == users.key(2) select key o
----
identities.key(3)
identities.key(4)
# A backlink binder.
query rowsort
  from u in users, i in u.<identities.user where u.name == "bo" select key i
----
identities.key(3)
identities.key(4)
# A binder over a key-preserving query.
query rowsort
  from x in (from u in users where u.name == "ann" select u) select key x
----
users.key(1)
query rowsort
  from x in (from f in follows where f.src == users.key(1) select f) select key x
----
follows.key(src: users.key(1), dst: users.key(2))
# A binder over a view that returns rows of one relation.
query rowsort
  from f in all_follows() where f.dst == users.key(2) select key f
----
follows.key(src: users.key(1), dst: users.key(2))
follows.key(src: users.key(3), dst: users.key(2))
# The binder of a match arm on such a row.
query rowsort
  from i in identities select match i
    | EmailPass e -> key e
    | Google g    -> key g
    | Apple a     -> key a
----
identities.key(1)
identities.key(2)
identities.key(3)
identities.key(4)
# A value of a type with a self-identifying Key field.
query rowsort
  from u in users select uid(u)
----
users.key(1)
users.key(2)
users.key(3)
query rowsort
  from x in (from i in identities select { n: 1, i: i }) select key x.i
----
identities.key(1)
identities.key(2)
identities.key(3)
identities.key(4)
# Anywhere else key x is refused.
error Invalid
  from x in (from f in follows select { src: f.src, dst: f.dst }) select key x
error Invalid
  from x in (from u in users select { id: key u, name: u.name }) select key x
error Invalid
  from x in (from u in users select u.name) select key x
error Invalid
  from x in (from f in follows select { a: f }) select key x.a
