# A comprehension's value is a set: projection merges equal values.
@SCHEMA@
@RUN@
query rowsort
  from i in identities select i.user
----
users.key(1)
users.key(2)
query
  count(a for a in (from i in identities select i.user))
----
2
query rowsort
  from f in follows select f.dst
----
users.key(2)
users.key(3)
query rowsort
  from i in identities select { user: i.user, oauth: match i | EmailPass _ -> false | Google _ -> true | Apple _ -> true }
----
{ user: users.key(1), oauth: false }
{ user: users.key(1), oauth: true }
{ user: users.key(2), oauth: true }
# A query's result need not be a set.
query
  count(u for u in users)
----
3
query
  { n: count(u for u in users) }
----
{ n: 3 }
# Printed order of a set result is ascending.
query
  from u in users select value(key u)
----
1
2
3
