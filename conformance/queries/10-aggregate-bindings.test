# An aggregate evaluates its value once per binding that satisfies its where, so equal values of distinct bindings each count.
schema
  module test
  type User = { id: Key users, name: Text }
  type Order = { id: Key orders, user: Key users, total: I64, qty: I64 }
  type Post = { id: Key posts, author: Key users, title: Text }
  relation users : User key id generate sequence
  relation orders : Order key id generate sequence
  relation posts : Post key id generate sequence
run
  insert users from [User { id: users.key(1), name: "ann" },
                     User { id: users.key(2), name: "bo" },
                     User { id: users.key(3), name: "cy" }]
  insert orders from [Order { id: orders.key(1), user: users.key(1), total: 100, qty: 2 },
                      Order { id: orders.key(2), user: users.key(1), total: 100, qty: 0 },
                      Order { id: orders.key(3), user: users.key(2), total: 30, qty: 3 },
                      Order { id: orders.key(4), user: users.key(1), total: 50, qty: 5 }]
  insert posts from [Post { id: posts.key(1), author: users.key(1), title: "a" },
                     Post { id: posts.key(2), author: users.key(1), title: "b" },
                     Post { id: posts.key(3), author: users.key(2), title: "c" }]
# Two orders of the same total add twice.
query
  sum(o.total for o in orders where o.user == users.key(1))
----
250
query
  count(o.total for o in orders where o.user == users.key(1))
----
3
query
  sum(o.total for o in orders)
----
280
# Per row of an enclosing query.
query rowsort
  from u in users select { name: u.name, s: sum(o.total for o in orders where o.user == key u) }
----
{ name: "ann", s: 250 }
{ name: "bo", s: 30 }
{ name: "cy", s: 0 }
# A generator over a set built by select ranges over its distinct values.
query
  count(a for a in (from p in posts select p.author))
----
2
query
  count(t for t in (from o in orders select o.total))
----
3
query
  max(t for t in (from o in orders select o.total))
----
Some { value: 100 }
query
  min(t for t in (from o in orders where o.qty > 0 select o.total))
----
Some { value: 30 }
# A generator over a set literal ranges over its elements once each.
query
  count(x for x in [1, 2, 2, 3])
----
3
query
  sum(x for x in [1, 2, 2, 3])
----
6
# The where selects the bindings whose values are combined.
query
  sum(o.qty for o in orders where o.total >= 100)
----
2
# Several generators range over every combination of their bindings.
query
  count(1 for u in users, p in posts where p.author == key u)
----
3
query
  count(1 for u in users, p in posts)
----
9
query
  sum(o.total for u in users, o in orders where o.user == key u and u.name == "ann")
----
250
