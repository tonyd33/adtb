# A function compared on an argument that branches on the outer row reads what a scan reads.
schema
  module test
  type Membership = { id: Key memberships, user: Text }
  relation memberships : Membership key id generate sequence unique (user)
  type Assignment = { id: Key assignments, mine: Bool, user: Text, other: Text }
  relation assignments : Assignment key id generate sequence
  type M = { id: Key ms, n: I64 }
  relation ms : M key id generate sequence index (n)
  type A = { id: Key as_, mine: Bool, x: I64, y: I64 }
  relation as_ : A key id generate sequence
  fn same (a: Text, b: Text) -> Bool = a == b
  fn same2 (a: Text, b: Text) -> Bool = a == b and b == a
  fn near (a: I64, b: I64) -> Bool = a >= b and a < b + 10
run
  insert memberships from [Membership { id: memberships.key(1), user: "ann" },
                           Membership { id: memberships.key(2), user: "bo" }]
  insert assignments from [Assignment { id: assignments.key(1), mine: false, user: "ann", other: "bo" },
                           Assignment { id: assignments.key(2), mine: true, user: "bo", other: "cy" }]
  insert ms from [M { id: ms.key(1), n: 3 }, M { id: ms.key(2), n: 12 }, M { id: ms.key(3), n: 25 }]
  insert as_ from [A { id: as_.key(1), mine: true, x: 10, y: 0 }, A { id: as_.key(2), mine: false, x: 0, y: 1 }]
query
  from a in assignments where key a == assignments.key(2) select (from m in memberships where same(m.user, if a.mine then a.user else a.other) select key m)
----
[memberships.key(2)]
query
  from a in assignments where key a == assignments.key(2) select (from m in memberships where same2(m.user, if a.mine then a.user else a.other) select key m)
----
[memberships.key(2)]
query
  from a in as_ where key a == as_.key(1) select (from m in ms where near(m.n, if a.mine then a.x else a.y) select key m)
----
[ms.key(2)]
query
  from a in as_ where key a == as_.key(2) select (from m in ms where near(m.n, if a.mine then a.x else a.y) select key m)
----
[ms.key(1)]
