# A deref whose row is unused still faults NoSuchRow when its key names no row, unless the key is a reference field of a row of the snapshot.
schema
  module test
  type User = { id: Key users, name: Text }
  type Phone = { id: Key phones, owner: Key users, seen: I64 }
  type Line = { id: Key lines, phone: Key phones }
  type Payment { id: Key payments, customer: Key users } = Card { last4: Text } | Invoice { due: Text }
  type Session = { id: Key sessions, owner: Option (Key users) }
  type Label = { id: Key tags, owner: Key users, label: Text, seen: I64 }
  type Res = { id: Key results, v: I64 }
  relation users : User key id generate sequence
  relation phones : Phone key id generate sequence
    computed probe: I64 = { a: self.owner.name, b: 1 }.b
  relation lines : Line key id generate sequence
  relation payments : Payment key id generate sequence
  relation sessions : Session key id generate sequence
  relation tags : Label key id generate sequence
    unique (label)
  relation results : Res key id generate sequence
  fn through_parameter (k: Key users) -> I64 = { a: k.name, b: 1 }.b
  fn through_row_parameter (p: Phone) -> I64 = { a: p.owner.name, b: 1 }.b
  fn same (k: Key users) -> Key users = k
  fn phone_of (k: Key users) -> Phone = Phone { id: phones.key(9), owner: k, seen: 0 }
  fn all_phones () -> Set Phone = from p in phones select p
  type Watch = { id: Key watches, owner: Key users, seen: I64 }
  type Badge = { id: Key badges, owner: Key users, seen: I64 }
  type Pager = { id: Key pagers, owner: Key users, seen: I64 }
  relation watches : Watch key id generate sequence
  relation badges : Badge key id generate sequence
  relation pagers : Pager key id generate sequence
  constraint watched = from w in watches where { a: w.owner.name, b: w.seen == 5 }.b select w
  constraint badged = from b in inserted(badges) where { a: b.owner.name, b: b.seen == 5 }.b select b
  check pos on pagers ({ a: self.owner.name, b: seen > 0 }.b)
run
  insert users from [User { id: users.key(1), name: "ann" }]
  insert phones from [Phone { id: phones.key(1), owner: users.key(1), seen: 1 }]
  insert lines from [Line { id: lines.key(1), phone: phones.key(1) }]
  insert payments.Card { id: payments.key(1), customer: users.key(1), last4: "x" }
  insert sessions from [Session { id: sessions.key(1), owner: Some { value: users.key(1) } }]
  insert tags from [Label { id: tags.key(1), owner: users.key(1), label: "t", seen: 0 }]
# A key built by r.key.
query
  try { a: users.key(99).name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  try { a: users.key(1).name, b: 1 }.b
----
Ok { value: 1 }
# A reference field of a constructor literal.
error Faulted
  { a: (Payment.Card { id: payments.key(5), customer: users.key(99), last4: "x" }).customer.name, b: 1 }.b
query
  try { a: (Payment.Card { id: payments.key(5), customer: users.key(99), last4: "x" }).customer.name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  try { a: (Payment.Card { id: payments.key(5), customer: users.key(1), last4: "x" }).customer.name, b: 1 }.b
----
Ok { value: 1 }
# A reference field of a one-constructor literal.
query
  try { a: (Phone { id: phones.key(5), owner: users.key(99), seen: 0 }).owner.name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  try { a: (Phone { id: phones.key(5), owner: users.key(1), seen: 0 }).owner.name, b: 1 }.b
----
Ok { value: 1 }
# A field of an anonymous record.
query
  try { a: { k: users.key(99) }.k.name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  try { a: { k: users.key(1) }.k.name, b: 1 }.b
----
Ok { value: 1 }
# A reference field of a stored row's copy made with `with`.
query
  from p in phones select try { a: (Phone { p with owner: users.key(99) }).owner.name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  from p in phones select try { a: (Phone { p with seen: 2 }).owner.name, b: 1 }.b
----
Ok { value: 1 }
# A field of an anonymous record's copy made with `with`.
query
  try { a: { { k: users.key(1) } with k: users.key(99) }.k.name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  try { a: { { k: users.key(99) } with k: users.key(1) }.k.name, b: 1 }.b
----
Ok { value: 1 }
# A comprehension binder over a set of keys.
query
  from k in [users.key(99)] select try { a: k.name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  from k in [users.key(1)] select try { a: k.name, b: 1 }.b
----
Ok { value: 1 }
# A function's key parameter.
query
  try through_parameter(users.key(99))
----
Err { error: NoSuchRow }
query
  try through_parameter(users.key(1))
----
Ok { value: 1 }
# A reference field of a function's row parameter.
query
  try through_row_parameter(Phone { id: phones.key(5), owner: users.key(99), seen: 0 })
----
Err { error: NoSuchRow }
query
  from p in phones select try through_row_parameter(p)
----
Ok { value: 1 }
# A function's key result.
query
  try { a: same(users.key(99)).name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  try { a: same(users.key(1)).name, b: 1 }.b
----
Ok { value: 1 }
# A reference field of a function's built row.
query
  try { a: phone_of(users.key(99)).owner.name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  try { a: phone_of(users.key(1)).owner.name, b: 1 }.b
----
Ok { value: 1 }
# The result of an `if`.
query
  try { a: (if 1 == 1 then users.key(99) else users.key(1)).name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  try { a: (if 1 == 1 then users.key(1) else users.key(99)).name, b: 1 }.b
----
Ok { value: 1 }
# The result of a `match`.
query
  try { a: (match 1 | 1 -> users.key(99) | _ -> users.key(1)).name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  try { a: (match 1 | 1 -> users.key(1) | _ -> users.key(99)).name, b: 1 }.b
----
Ok { value: 1 }
# A reference field of a binder a match on a constructor literal binds.
query
  try match Payment.Card { id: payments.key(5), customer: users.key(99), last4: "x" }
    | Card c -> { a: c.customer.name, b: 1 }.b
----
Err { error: NoSuchRow }
query
  try match Payment.Card { id: payments.key(5), customer: users.key(1), last4: "x" }
    | Card c -> { a: c.customer.name, b: 1 }.b
----
Ok { value: 1 }
# A key an optional value holds.
query
  try match (if 1 == 1 then Some { value: users.key(99) } else None)
    | Some { value: k } -> { a: k.name, b: 1 }.b
    | None -> 2
----
Err { error: NoSuchRow }
query
  from s in sessions select try match s.owner
    | Some { value: k } -> { a: k.name, b: 1 }.b
    | None -> 2
----
Ok { value: 1 }
# The key of a stored row.
query
  from u in users select try { a: (key u).name, b: 1 }.b
----
Ok { value: 1 }
# A group's key.
query
  from p in phones group p by p.owner into g select try { a: g.key.name, b: 1 }.b
----
Ok { value: 1 }
# A reference field of a stored row names a row.
query
  from p in phones select try { a: p.owner.name, b: 1 }.b
----
Ok { value: 1 }
# A reference read from a stored row and bound by a generator names a row.
query
  from k in (from p in phones select p.owner) select try { a: k.name, b: 1 }.b
----
Ok { value: 1 }
# A row read through a reference, from a function or by a match over a stored row is a stored row.
query
  from l in lines select try { a: l.phone.owner.name, b: 1 }.b
----
Ok { value: 1 }
query
  from p in all_phones() select try { a: p.owner.name, b: 1 }.b
----
Ok { value: 1 }
query
  from p in payments select try match p
    | Card c -> { a: c.customer.name, b: 1 }.b
    | Invoice i -> 2
----
Ok { value: 1 }
query
  from p in phones select try p.probe
----
Ok { value: 1 }
# A reference field of the row an upsert proposes, which no constraint checks when it conflicts.
run
  insert tags { id: tags.key(5), owner: users.key(99), label: "t", seen: 0 }
  unless conflict on (label)
  else update old set Label { old with seen: match try { a: new.owner.name, b: 2 }.b
    | Ok { value: v } -> v
    | Err { error: NoSuchRow } -> -1
    | Err { error: e } -> -2 }
query
  from t in tags select t.seen
----
-1
run
  insert tags { id: tags.key(5), owner: users.key(1), label: "t", seen: 0 }
  unless conflict on (label)
  else update old set Label { old with seen: match try { a: new.owner.name, b: 2 }.b
    | Ok { value: v } -> v
    | Err { error: NoSuchRow } -> -1
    | Err { error: e } -> -2 }
query
  from t in tags select t.seen
----
2
# A generator binder over rows a write proposes, whose reference names a row the same block inserts.
run
  transact
    insert users { id: users.key(10), name: "new" }
    let ps = insert phones from [Phone { id: phones.key(10), owner: users.key(10), seen: 0 }]
    insert results from (from p in ps select Res { id: results.key(10), v: match try ({ a: p.owner.name, b: 1 }.b)
      | Ok { value: v } -> v
      | Err { error: NoSuchRow } -> -1
      | Err { error: e } -> -2 })
query
  from r in results where r.id == results.key(10) select r.v
----
-1
