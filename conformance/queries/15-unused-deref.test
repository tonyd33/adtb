# A reference field of a row a constraint reads from a relation, in the state after the statement.
error Faulted
  insert watches { id: watches.key(1), owner: users.key(99), seen: 1 }
run
  insert watches { id: watches.key(1), owner: users.key(1), seen: 1 }
# A reference field of a row a constraint reads from `inserted`.
error Faulted
  insert badges { id: badges.key(1), owner: users.key(99), seen: 1 }
run
  insert badges { id: badges.key(1), owner: users.key(1), seen: 1 }
# A reference field of a row check's `self`.
error Faulted
  insert pagers { id: pagers.key(1), owner: users.key(99), seen: 1 }
run
  insert pagers { id: pagers.key(1), owner: users.key(1), seen: 1 }
