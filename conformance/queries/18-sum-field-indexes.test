invoices.key(60)
invoices.key(7)
invoices.key(9)
query rowsort
  from i in invoices group i by tag(i.status) into g select { stage: g.key, n: count(x for x in g) }
----
{ n: 12, stage: Paid }
{ n: 23, stage: Sent }
{ n: 25, stage: Draft }
# A range of whole statuses runs from one constructor's values into another's.
query rowsort
  from i in invoices where i.status >= Sent { at: 0 } and i.status < Paid { at: 0, ref: 0 } select i
