Invoice { id: invoices.key(6), status: Paid { at: -13, ref: 8 } }
# A field of one constructor holds an entry only for rows of that constructor.
query rowsort
  from i in invoices where (match i.status | Paid p -> p.ref == 8 | Draft -> false | Sent s -> false) select i
----
Invoice { id: invoices.key(40), status: Paid { at: -12, ref: 8 } }
Invoice { id: invoices.key(6), status: Paid { at: -13, ref: 8 } }
