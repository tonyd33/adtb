-- discarded_heap_writes: a heap write's `Undoable` passed to `mem::forget` or `ManuallyDrop`,
-- which skips the check its drop makes that `record` or `kept` consumed it.

forgotten = do {
  c <- descendants_of_kind :call_expression;
  f <- pure c | #function;
  guard $ text f ~ r"(^|::)(forget|ManuallyDrop::new)$";
  guard $ text c ~ r"\.(insert_pruning|update_pruning|retag_pruning|delete)\s*\(";
  return c;
};

main = forgotten | arr range;
