-- capability_renames: `Abandons`, `UncheckedWriter` or `StopsEarly` imported, re-exported or
-- aliased under another name, or named inside a macro's tokens, where an impl or a call is not
-- counted.

capability = r"(^|::)(Abandons|UncheckedWriter|StopsEarly)$";

renamed_uses = do {
  u <- descendants_of_kind :use_as_clause;
  p <- pure u | #path;
  guard $ text p ~ capability;
  return u;
};

aliases = do {
  t <- descendants_of_kind :type_item;
  v <- pure t | #type;
  guard $ text v ~ capability;
  return t;
};

in_macros = do {
  t <- descendants_of_kind :token_tree;
  n <- pure t | children_of_kind :identifier;
  guard $ text n ~ capability;
  return n;
};

main = (renamed_uses `alt` aliases `alt` in_macros) | arr (\n -> ("capability_renames", range n));
