-- from_raw: a call of a catalog id's `from_raw`, or of `Stored::new`, the decode of a raw value
-- as one id kind.

main = collect (do {
  c <- descendants_of_kind :call_expression;
  f <- pure c | #function;
  guard $ text f ~ r"(Cat[A-Za-z]+Id::from_raw|Stored(::<[A-Za-z]+>)?::new)$";
  return c;
}) | arr length;
