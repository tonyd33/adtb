-- serializer_writes: a use of `write_at`, which checks a write against the SIREAD locks on its
-- version, outside `Superseded::check`, which a heap write returns only after its page change.

uses = do {
  n <- descendants_of_kind :field_identifier `alt` descendants_of_kind :identifier;
  guard $ text n == "write_at";
  return n;
};

definitions = do {
  f <- descendants_of_kind :function_item;
  name <- pure f | #name;
  guard $ text name == "write_at";
  return name;
};

checked = do {
  i <- descendants_of_kind :impl_item;
  t <- pure i | #type;
  guard $ text t == "Superseded";
  f <- pure i | descendants_of_kind :function_item;
  name <- pure f | #name;
  guard $ text name == "check";
  n <- pure f | descendants_of_kind :field_identifier `alt` descendants_of_kind :identifier;
  guard $ text n == "write_at";
  return n;
};

main = do {
  a <- collect uses | arr length;
  d <- collect definitions | arr length;
  c <- collect checked | arr length;
  return (("serializer_writes", (a - d - c)));
};
