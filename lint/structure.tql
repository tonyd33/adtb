-- pub_fields: fields declared `pub`, of a struct or union of any visibility, and those a
-- `macro_rules!` body declares in a struct, once per definition. Each such type states its
-- contract. Not seen: a field whose visibility a macro takes as a `$vis` fragment, a field of a
-- struct a macro declares with generics or a `where` clause before its body, and a field of a
-- struct declared inside a `$(..)*` repetition.
-- crate_fields: the same fields declared pub(crate), pub(super) or pub(in ..): internal state
-- visible past its module.
-- decode_panics: panicking macros by any path, `todo!` and `unimplemented!` among them; `expect`,
-- `unwrap`, `expect_err` and `unwrap_err` as methods, as paths (`Option::unwrap(x)`,
-- `.map(Result::unwrap)`) and inside the tokens of another macro; `panic::panic_any` and
-- `process::abort`; and a function declared `-> !`. Not seen: a call of a diverging function
-- defined in another file, an `abort` or `panic_any` imported under its bare name and called, an
-- index or a slice past its end, arithmetic overflow, and a panic inside a function of another
-- module the decode calls. A decode of bytes read from a page
-- returns `Result` with its damage cause. The sites left guard values the engine built in memory or
-- checked first, a caller's latch discipline (heap/named.rs), or a surface built only for tests
-- and the testing feature (heap/handle/observe.rs).
-- adtb_decode_panics: the same sites, in the engine crate's decode files, where none is left. The
-- catalog codec's builders and encoders (catalog/codec/encode.rs) guard values the engine built and
-- are in neither file set.

import Data.List (Sized(..));

field_visibility = do {
  s <- descendants_of_kind :struct_item `alt` descendants_of_kind :union_item;
  body <- pure s | #body;
  vis <- pure body | alt (children_of_kind :field_declaration | children_of_kind :visibility_modifier) (children_of_kind :visibility_modifier);
  return $ text vis;
};

restricted v = text v ~ r"^\(\s*(crate|super|in\s)";

-- Returns the (pub, restricted) counts of the `pub` tokens of a struct body's tokens.
visible ts = case ts of {
  [] -> (0, 0);
  t : rest -> let { more = visible rest; } in
    if text t == "pub" then case rest of {
      v : _ -> if restricted v then (fst more, snd more + 1) else (fst more + 1, snd more);
      [] -> (fst more + 1, snd more);
    } else more;
};

-- Returns the (pub, restricted) counts of the fields of each struct a macro's tokens declare.
bodies ts = case ts of {
  s : n : b : rest -> let { more = bodies (n : b : rest); } in
    if (text s == "struct") `and` (is_kind :token_tree b)
    then let { here = visible (run descendants b); } in (fst here + fst more, snd here + snd more)
    else more;
  _ -> (0, 0);
};

macro_fields = do {
  m <- descendants_of_kind :macro_definition;
  t <- pure m | descendants_of_kind :token_tree;
  return (bodies (run children t));
};

pub_fields = do {
  d <- collect (field_visibility | keep (\v -> v == "pub")) | arr length;
  m <- collect (macro_fields | arr fst);
  return (d + sum m);
};

crate_fields = do {
  d <- collect (field_visibility | keep (\v -> v ~ r"^pub\((crate|super|in )")) | arr length;
  m <- collect (macro_fields | arr snd);
  return (d + sum m);
};

sum xs = case xs of {
  [] -> 0;
  x : rest -> x + sum rest;
};

panic_macro = r"^((::)?(std|core)::)?(debug_)?(panic|unreachable|todo|unimplemented|assert|assert_eq|assert_ne)$";

panicking_macros = do {
  m <- descendants_of_kind :macro_invocation;
  n <- pure m | #macro;
  guard $ text n ~ panic_macro;
  return m;
};

panicking_calls = do {
  c <- descendants_of_kind :call_expression;
  f <- pure c | #function;
  m <- pure f | #field;
  guard $ text m ~ r"^(expect|unwrap|expect_err|unwrap_err)$";
  return c;
};

panicking_paths = do {
  p <- descendants_of_kind :scoped_identifier;
  guard $ text p ~ r"::(expect|unwrap|expect_err|unwrap_err)$|(^|::)(panic::panic_any|process::abort)$|^panic_any$";
  return p;
};

macro_body_panics = do {
  m <- descendants_of_kind :macro_invocation;
  n <- pure m | #macro;
  guard $ not (text n ~ panic_macro);
  guard $ text m ~ r"\.\s*(unwrap|expect|unwrap_err|expect_err)\s*\(";
  return m;
};

diverging_fns = do {
  f <- descendants_of_kind :function_item;
  r <- pure f | #return_type;
  guard $ text r == "!";
  return f;
};

decode_panics = collect (panicking_macros `alt` panicking_calls `alt` panicking_paths `alt` macro_body_panics `alt` diverging_fns) | arr length;

main = do {
  p <- pub_fields;
  c <- crate_fields;
  d <- decode_panics;
  return (("pub_fields", p), ("crate_fields", c), ("decode_panics", d), ("adtb_decode_panics", d));
};
